{
  "name": "@capybara-hq/device",
  "version": "0.1.0-rc.11",
  "description": "capybara-device: connects a laptop or server to a Capybara deployment as a device",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capybara-hq/core.git",
    "directory": "packages/device"
  },
  "homepage": "https://github.com/capybara-hq/core/tree/main/packages/device#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "capybara-device": "./bin/capybara-device.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@capybara-hq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@capybara-hq/plugin-sdk": "workspace:^",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  }
}
