{
  "name": "@capybara-hq/testing",
  "version": "0.1.0-rc.0",
  "description": "Test helpers for Capybara: test containers, dual-replica harness and fake third-party servers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capybara-hq/core.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/capybara-hq/core/tree/main/packages/testing#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@capybara-hq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./global-setup": {
      "@capybara-hq/source": "./src/global-setup.ts",
      "types": "./dist/global-setup.d.ts",
      "import": "./dist/global-setup.js",
      "default": "./dist/global-setup.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./global-setup": {
        "types": "./dist/global-setup.d.ts",
        "import": "./dist/global-setup.js",
        "default": "./dist/global-setup.js"
      }
    }
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-presigned-post": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@capybara-hq/kernel": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@testcontainers/postgresql": "^12.2.1",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "protobufjs": "^7.5.4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capybara-hq/plugin-sdk": "workspace:^",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2"
  },
  "peerDependencies": {
    "@capybara-hq/plugin-sdk": "workspace:^",
    "vitest": "^5.0.5",
    "@capybara-hq/plugin-tools": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@capybara-hq/plugin-tools": {
      "optional": true
    }
  }
}
