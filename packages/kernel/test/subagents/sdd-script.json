              "subagent_type": "superpowers:code-reviewer",
              "model": "capable",
              "prompt": "FINAL-REVIEW: Review the whole branch against /workspace/plan.md. The review package is /workspace/.superpowers/sdd/plan/final.diff."
            }
          },
          {
            "name": "Agent",
            "input": {
              "description": "Check files",
              "model": "fast",
              "prompt": "CHECK-FILES: Check that /workspace/greeting.txt and /workspace/farewell.txt hold the planned content."
            }
          },
          {
            "name": "Bash",
            "input": {
              "description": "Test step",
              "command": "until [ -f /workspace/.superpowers/sdd/plan/done-FINAL-REVIEW ] && [ -f /workspace/.superpowers/sdd/plan/done-CHECK-FILES ]; do sleep 0.05; done; echo WAITED FINAL-REVIEW CHECK-FILES",
              "timeout": 60000
            }
          }
        ]
      }
    },
    {
      "when": {
        "lastUserIncludes": "SDD-RUN",
        "lastToolResultIncludes": "WAITED FINAL-REVIEW CHECK-FILES"
      },
      "reply": {
        "text": "Plan complete: both tasks are implemented, reviewed and committed."
      }
    }
  ]
}
