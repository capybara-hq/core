      "toolSpecs": {
        "35669c0ffc71c9a6": {
          "name": "Agent",
          "keyArgs": [
            "description",
            "subagent_type"
          ],
          "description": "Dispatch a sub-agent: a fresh agent with its own context that works on one task and returns its final reply as this tool's result. The sub-agent sees only your prompt, not this conversation, so include everything it needs and say what its final reply must contain. It shares your sandbox files. You wait until it finishes. To run several at once, call this tool several times in the same response (at most 4 at a time); their commands run in the sandbox at the same time, so give parallel sub-agents separate files or directories. Sub-agents cannot dispatch sub-agents or ask the user questions. To send a finished sub-agent a follow-up while keeping its context, pass the agentId from its result as resume.\n\nAgent types (subagent_type):\n- general-purpose: a copy of you with your tools and skills, for multi-step work.",
          "inputSchema": {
            "type": "object",
            "required": [
              "description",
              "prompt"
            ],
            "properties": {
              "model": {
                "enum": [
                  "inherit",
                  "fast",
                  "standard",
                  "capable"
                ],
                "type": "string",
                "description": "Model tier for this sub-agent: fast and cheap for mechanical work, standard for integration and judgment, capable for design and final reviews. Defaults to the agent type's own setting, else your model."
              },
              "prompt": {
                "type": "string",
                "maxLength": 100000,
                "minLength": 1,
                "description": "The complete task for the sub-agent. It sees nothing else of this conversation: include every fact, file path and constraint it needs, and say what its final reply must contain."
              },
              "resume": {
                "type": "string",
                "maxLength": 64,
                "description": "The agentId from an earlier result of this tool: sends prompt to that sub-agent as a follow-up, with its earlier context intact. Leave subagent_type and model unset."
              },
              "description": {
                "type": "string",
                "maxLength": 80,
                "minLength": 1,
                "description": "A short label for the task (3 to 6 words), shown to the user."
              },
              "subagent_type": {
                "type": "string",
                "maxLength": 130,
                "minLength": 1,
                "description": "Which agent type to run, from the list in this tool's description. Defaults to general-purpose."
              }
            },
            "additionalProperties": false
          }
        }
      }
