{
  "name": "@capybara-hq/plugin-sdk",
  "version": "0.1.0",
  "description": "Capybara plugin SDK: the types and pure functions plugins are written against",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capybara-hq/core.git",
    "directory": "packages/plugin-sdk"
  },
