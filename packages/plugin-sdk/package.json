  },
  "dependencies": {
    "kysely": "^0.29.6",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
