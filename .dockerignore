# Build context for docker/*.Dockerfile: sources, manifests and the lockfile only.
**/node_modules
**/dist
**/*.tsbuildinfo
**/coverage
**/.next
.git
.github
.claude
.superpowers
.changeset
.capybara-pack-*
artifacts
# A source checkout's offline bootstrap packages (the image mounts its own at /app/bootstrap)
bootstrap
docs
.agents
apps/web/visual
apps/web/e2e
apps/web/test
apps/web/compare
apps/web/compare-out*
apps/web/reference
**/test-results
**/playwright-report
**/.DS_Store
**/.env
**/.env.*
# Compose deployment secrets (admin password file and the like) never enter a build context.
docker/secrets
