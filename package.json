{
  "name": "capybara",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "doctor:env": "node tools/dev/src/doctor-cli.ts",
    "verify": "tsx tools/dev/src/verify-cli.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && pnpm --filter @capybara-hq/web typecheck",
    "test": "vitest run",
    "dev:web": "pnpm --filter @capybara-hq/web dev",
    "check": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/all.ts",
    "changeset": "changeset",
    "check:migrations": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/migrations.ts",
    "check:deps": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/deps.ts",
    "check:plugin-state": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/plugin-state.ts",
    "check:plugin-permissions": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/plugin-permissions.ts",
    "check:tool-design": "tsx --tsconfig tsconfig.base.json tools/checks/src/cli/tool-design.ts",
    "check:config-docs": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/config-docs.ts",
    "check:i18n": "tsx --tsconfig tsconfig.base.json tools/checks/src/cli/i18n.ts",
    "check:web-ui": "tsx --tsconfig tsconfig.base.json tools/checks/src/cli/web-ui.ts",
    "check:plugin-pack": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/plugin-pack.ts",
    "check:test-plugins": "tsx --tsconfig tsconfig.base.json tools/checks/src/cli/test-plugins.ts",
    "check:synced-skills": "tsx --tsconfig tsconfig.base.json tools/checks/src/cli/synced-skills.ts",
    "check:compose-haproxy": "tsx --tsconfig tsconfig.base.json tools/checks/src/cli/compose-haproxy.ts",
    "check:package-schemas": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/package-schemas.ts",
    "gen:package-schemas": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/gen-package-schemas.ts",
    "gen:config-docs": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/checks/src/cli/gen-config-docs.ts",
    "pack-plugin": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/pack-plugin/src/cli.ts",
    "pack-plugins": "tsx --tsconfig tsconfig.base.json --conditions=@capybara-hq/source tools/pack-plugin/src/cli.ts --all",
    "capybara": "node apps/capybara/bin/capybara.mjs",
    "wt:new": "tsx tools/worktree/src/cli.ts new",
    "wt:rm": "tsx tools/worktree/src/cli.ts rm",
    "wt:ls": "tsx tools/worktree/src/cli.ts ls"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@capybara-hq/capybara": "workspace:*",
    "@capybara-hq/plugin-anthropic": "workspace:*",
    "@capybara-hq/plugin-connector-mcp": "workspace:*",
    "@capybara-hq/plugin-connector-openapi": "workspace:*",
    "@capybara-hq/plugin-example-counter": "workspace:*",
    "@capybara-hq/plugin-model-fake": "workspace:*",
    "@capybara-hq/plugin-object-store-s3": "workspace:*",
    "@capybara-hq/plugin-openai": "workspace:*",
    "@capybara-hq/plugin-openai-compatible": "workspace:*",
    "@capybara-hq/plugin-sandbox-docker": "workspace:*",
    "@capybara-hq/plugin-sandbox-e2b": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
