{
  "version": 1,
  "color": {
    "bg": { "dark": "#0A0A0A", "light": "#F7F6F2", "purpose": "Page background" },
    "panel": { "dark": "#111110", "purpose": "Cards" },
    "ink": { "dark": "#E6E6E3", "light": "#1A1A18", "purpose": "Text" },
    "muted": { "dark": "#8E8E89", "light": "#5E5E5A", "purpose": "Secondary text" },
    "accent": { "dark": "#FF6A13", "light": "#CC4609", "purpose": "Primary action" },
    "accent-tint": {
      "dark": "color-mix(in srgb, var(--cb-accent) 12%, transparent)",
      "light": "color-mix(in srgb, var(--cb-accent) 12%, transparent)",
      "purpose": "Tinted accent ground"
    },
    "scrim": { "dark": "rgba(0,0,0,.60)", "light": "rgba(10,10,10,.25)", "purpose": "Behind dialogs" }
  },
  "shadow": {
    "shadow-1": { "dark": "0 8px 24px rgba(0,0,0,.40)", "light": "0 2px 8px rgba(10,10,10,.08)", "purpose": "Popovers" }
  },
  "size": {
    "control": { "dense": 24, "default": 28 },
    "row": { "default": 32 },
    "space": { "1": 4, "2": 8 },
    "pad": { "dense": [4, 8] },
    "radius": { "sm": 4 },
    "type": { "body": [13, 20] },
    "layout": { "sidebar": 256 }
  },
  "motion": { "hover": "120ms", "expand": "160ms" },
  "font": {
    "mono": "\"Sarasa Mono SC\", ui-monospace, monospace",
    "prose": "\"Inter\", \"Source Han Sans SC\", system-ui, sans-serif"
  },
  "z": { "dialog": 50 },
  "contrast": [["ink", "bg", 4.5], ["muted", "bg", 4.5], ["accent", "bg", 3], ["accent-tint", "bg", 3]]
}
