# Copy to .env next to compose.yaml and fill in the required values. Keep .env out of version
# control: it holds the deployment's secrets.

# ---- HTTPS or localhost ----
# Session cookies carry the Secure attribute, so browsers keep them only over HTTPS or on
# http://localhost. Opened over plain http on any other host name (an IP address, a LAN name),
# login appears to succeed and then drops you back at the login page. Serve web over HTTPS (a TLS
# proxy in front, see CAPYBARA_WEB_BIND and CAPYBARA_WEB_TRUST_PROXY below) or, for a short trial
# only, set both of these (the public URL is where browsers upload and download attachments; left
# at localhost, uploads from other machines fail):
# CAPYBARA_COOKIE_SECURE=false
# CAPYBARA_PUBLIC_URL=http://192.168.1.20:3000

# ---- Required ----

# PostgreSQL password (letters and digits only: it is embedded in the connection URL).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Master key for secret encryption: 32 random bytes, base64. Back it up; without it, encrypted
# secrets (plugin and connector credentials) cannot be read.
#   openssl rand -base64 32
CAPYBARA_MASTER_KEY=

# Credentials of the bundled SeaweedFS S3 service (used by the object-store-s3 bootstrap plugin).
# Hex only (they are embedded in a JSON config):
#   openssl rand -hex 24
CAPYBARA_S3_ACCESS_KEY=
CAPYBARA_S3_SECRET_KEY=

# Token the web setup page asks for when it creates the first enterprise admin, so whoever reaches
# the port first can't take the deployment over. Leave it set even if you use the admin password
# file below; with that file the admin already exists and the token is moot.
#   openssl rand -hex 16
CAPYBARA_SETUP_TOKEN=

# ---- Enterprise admin (optional) ----

# A file holding the admin password on one line. When set, init creates the enterprise admin on
# the first start (and skips once one exists). When unset, create the admin on the web setup
# page instead. Relative paths are relative to compose.yaml; init reads it as root, so mode 600
# is fine:
#   mkdir -p secrets && openssl rand -base64 18 > secrets/admin_password
#   chmod 600 secrets/admin_password
# After the first start, change the password in the web app and overwrite the file's content
# (e.g. `echo unused > secrets/admin_password`): once an admin exists init skips without reading
# it. Don't just delete it while this is set: the existing init container still mounts it and
# would fail to start; to remove it, unset this, delete the file and run
# `docker compose up -d --force-recreate --no-deps init`.
# Setting it after the first start needs `docker compose up -d --force-recreate --no-deps init`
# (compose does not recreate init when only the secret's file changes).
# When unset, compose mounts /dev/null in its place, which does not work on Windows hosts; there,
# always set this to a password file.
# CAPYBARA_INIT_ADMIN_PASSWORD_FILE=./secrets/admin_password
CAPYBARA_INIT_ADMIN_LOGIN=admin
CAPYBARA_INIT_ADMIN_NAME=Administrator

# ---- Optional ----

# Image version, and the registry prefix (unset: ghcr.io/capybara-hq/; empty: local tags built
# with compose.build.yaml).
# CAPYBARA_VERSION=0.1.0-rc.0
# CAPYBARA_IMAGE_PREFIX=

# Host address and port of the web app (the only published port). Behind a TLS proxy on the same
# host, bind to 127.0.0.1 so plain http is not exposed.
# CAPYBARA_WEB_BIND=0.0.0.0
# CAPYBARA_WEB_PORT=3000

# Externally reachable origin of the web app, exactly as browsers open it (scheme, host and any
# port). OAuth redirects, sign-in callbacks and presigned attachment URLs (served by web's
# object-storage proxy) use it. Default: http://localhost:<CAPYBARA_WEB_PORT>.
# CAPYBARA_PUBLIC_URL=https://capybara.example.com

# A TLS proxy or load balancer in front of web, so web forwards the real client address (otherwise
# every client shares one login rate limit):
# - a proxy on this host: CAPYBARA_WEB_BIND=127.0.0.1 and CAPYBARA_WEB_TRUST_PROXY=1 (one hop; safe
#   because clients can't reach web directly);
# - a proxy on another host (web's port firewalled to it): its addresses / CIDRs, comma-separated.
# The proxy's address as web sees it: a host-side proxy connects from the gateway of the "frontend"
# network (not "default"): docker network inspect capybara_frontend --format
# '{{range .IPAM.Config}}{{.Gateway}}{{end}}'. A /0 CIDR is refused.
# CAPYBARA_WEB_TRUST_PROXY=1

# The official plugin marketplace (the capybara-hq/plugins repository on github.com). Set to false
# on a host without internet access: the admin console then shows offline mode and never fetches it.
# CAPYBARA_OFFICIAL_MARKETPLACE=true

# Only when the gateway webhook port is published (see compose.yaml): the front proxy's addresses
# or CIDRs (comma-separated). Never 1.
# CAPYBARA_GATEWAY_TRUST_PROXY=false
# CAPYBARA_GATEWAY_PORT=8081
