# Copy to .env next to compose.yaml and fill in the required values. Keep .env out of version
# control: it holds the deployment's secrets.

# ---- Required ----

# PostgreSQL password (letters and digits only: it is embedded in the connection URL).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Master key for secret encryption: 32 random bytes, base64. Back it up; without it, encrypted
# secrets (plugin and connector credentials) cannot be read.
#   openssl rand -base64 32
CAPYBARA_MASTER_KEY=

# Credentials of the bundled SeaweedFS S3 service (used by the builtin object-store-s3 plugin).
#   openssl rand -hex 24
CAPYBARA_S3_ACCESS_KEY=capybara
CAPYBARA_S3_SECRET_KEY=

# ---- Enterprise admin (optional) ----

# A file holding the admin password on one line. When set, init creates the enterprise admin on
# the first start (and skips once one exists). When unset, create the admin on the web setup
# page instead. Relative paths are relative to compose.yaml. On Linux the file must be readable
# by the container user (uid 10001), e.g.:
#   mkdir -p secrets && openssl rand -base64 18 > secrets/admin_password
#   sudo chown 10001 secrets/admin_password && sudo chmod 600 secrets/admin_password
# Setting it after the first start needs `docker compose up -d --force-recreate --no-deps init`
# (compose does not recreate init when only the secret's file changes).
# CAPYBARA_INIT_ADMIN_PASSWORD_FILE=./secrets/admin_password
CAPYBARA_INIT_ADMIN_LOGIN=admin
CAPYBARA_INIT_ADMIN_NAME=Administrator

# ---- Optional ----

# Image version, and the registry prefix (unset: ghcr.io/capybara-hq/; empty: local tags built
# with compose.build.yaml).
# CAPYBARA_VERSION=0.1.0
# CAPYBARA_IMAGE_PREFIX=

# Host port of the web app (the only published port).
# CAPYBARA_WEB_PORT=3000

# Externally reachable origin of the web app (OAuth redirects and sign-in callbacks use it).
# CAPYBARA_PUBLIC_URL=https://capybara.example.com

# Session cookies carry the Secure attribute, so browsers send them only over HTTPS (and to
# http://localhost). Set false only for a trial over plain http on another host name.
# CAPYBARA_COOKIE_SECURE=true

# A TLS proxy or load balancer in front of web: its hop count or its addresses / CIDRs, so web
# forwards the real client address (otherwise every client shares one login rate limit).
# CAPYBARA_WEB_TRUST_PROXY=1

# Only when the gateway webhook port is published (see compose.yaml): the front proxy's address
# or CIDR. Never 1.
# CAPYBARA_GATEWAY_TRUST_PROXY=false
# CAPYBARA_GATEWAY_PORT=8081
