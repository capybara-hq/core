{
  "version": 1,
  "color": {
    "bg": { "dark": "#0A0A0A", "light": "#F7F6F2", "purpose": "Page background" },
    "panel": { "dark": "#111110", "light": "#FFFFFF", "purpose": "Cards, table container, stat cards, form field cards, overlays" },
    "panel-2": { "dark": "#0E0E0D", "light": "#FBFAF7", "purpose": "Action row, right-panel ground" },
    "sidebar": { "dark": "#111110", "light": "#EFEEE9", "purpose": "Sidebar ground" },
    "sidebar-active": { "dark": "#1A1A18", "light": "#E2E1DB", "purpose": "Current nav item or conversation in the sidebar" },
    "raised": { "dark": "#141413", "light": "#FFFFFF", "purpose": "Floating inline cards, the composer" },
    "selected": { "dark": "#1F1F1D", "light": "#ECEBE6", "purpose": "Selected segment, selected filter chip ground, avatar" },
    "hover": { "dark": "#171716", "light": "#F4F3EF", "purpose": "Hover ground" },
    "line-soft": { "dark": "#1C1C1A", "light": "#E6E5E0", "purpose": "Column dividers, table row dividers, the status bar's top line" },
    "line": { "dark": "#2A2A28", "light": "#D6D5CF", "purpose": "Input and button border" },
    "line-strong": { "dark": "#3A3A37", "light": "#B5B5AE", "purpose": "Overlay border" },
    "ink": { "dark": "#E6E6E3", "light": "#1A1A18", "purpose": "Text" },
    "muted": { "dark": "#8E8E89", "light": "#5E5E5A", "purpose": "Secondary text, sidebar group labels" },
    "faint": { "dark": "#5A5A56", "light": "#9A9A94", "purpose": "Placeholders and separators only, never essential text" },
    "accent": { "dark": "#FF6A13", "light": "#CC4609", "purpose": "Primary action, focus, current navigation (spec §2.3)" },
    "accent-hover": { "dark": "#FF8240", "light": "#B83F08", "purpose": "Accent hover" },
    "accent-press": { "dark": "#E85A08", "light": "#A33707", "purpose": "Accent pressed" },
    "on-accent": { "dark": "#0A0A0A", "light": "#FFFFFF", "purpose": "Text on accent" },
    "accent-tint": {
      "dark": "color-mix(in srgb, var(--cb-accent) 12%, transparent)",
      "light": "color-mix(in srgb, var(--cb-accent) 12%, transparent)",
      "purpose": "Tinted accent ground"
    },
    "focus-ring": { "dark": "rgba(255,106,19,.25)", "light": "rgba(204,70,9,.18)", "purpose": "3px input focus halo" },
    "ok": { "dark": "#3FD483", "light": "#16803F", "purpose": "Success (rarely shown: success is not colored, spec §4.2.2)" },
    "fail": { "dark": "#FF5C52", "light": "#C8302A", "purpose": "Failure" },
    "warn": { "dark": "#F2C14B", "light": "#8F6500", "purpose": "Needs a person" },
    "scrim": { "dark": "rgba(0,0,0,.60)", "light": "rgba(10,10,10,.25)", "purpose": "Behind dialogs and sheets" },
    "diff-add": { "dark": "rgba(63,212,131,.08)", "light": "rgba(22,128,63,.10)", "purpose": "Added lines in a diff" },
    "diff-del": { "dark": "rgba(255,92,82,.08)", "light": "rgba(207,34,46,.08)", "purpose": "Removed lines in a diff" }
  },
  "shadow": {
    "shadow-1": { "dark": "0 8px 24px rgba(0,0,0,.40)", "light": "0 2px 8px rgba(10,10,10,.08)", "purpose": "Popovers, menus" },
    "shadow-2": { "dark": "0 16px 48px rgba(0,0,0,.50)", "light": "0 8px 24px rgba(10,10,10,.12)", "purpose": "Dialogs" },
    "shadow-sheet": { "dark": "-16px 0 40px rgba(0,0,0,.40)", "light": "-4px 0 16px rgba(10,10,10,.08)", "purpose": "Side sheets" },
    "shadow-float": { "dark": "0 8px 24px rgba(0,0,0,.45)", "light": "0 8px 24px rgba(26,26,24,.08)", "purpose": "The composer, the sidebar drawer" }
  },
  "size": {
    "control": { "dense": 24, "default": 28, "prominent": 32 },
    "row": { "dense": 28, "default": 32, "roomy": 44 },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40 },
    "pad": { "dense": [4, 8], "default": [6, 12] },
    "radius": { "sm": 4, "md": 8, "bubble": 10 },
    "type": {
      "micro": [11, 14],
      "small": [12, 16],
      "body": [13, 20],
      "h2": [16, 24],
      "h1": [20, 28],
      "prose": [15, 26],
      "prose-small": [13, 20],
      "metric": [18, 24]
    },
    "layout": {
      "sidebar": 256,
      "sidebar-rail": 48,
      "content-list": 1080,
      "content-form": 880,
      "chat": 720,
      "status-bar": 24,
      "action-row": 40,
      "gutter": 20,
      "title-bar": 48,
      "properties": 300,
      "panel-min": 520,
      "panel": 560,
      "chat-min": 480,
      "tool-output": 120,
      "file-card": 240,
      "thumb": 56,
      "inline-image": 360
    }
  },
  "motion": { "hover": "120ms", "expand": "160ms", "overlay": "120ms", "cursor": "1000ms", "spin": "800ms" },
  "font": {
    "mono": "\"Sarasa Mono SC\", ui-monospace, monospace",
    "prose": "\"Inter\", \"Source Han Sans SC\", system-ui, sans-serif"
  },
  "z": { "sheet": 40, "dialog": 50, "popover": 60, "toast": 70 },
  "contrast": [
    ["ink", "bg", 4.5],
    ["muted", "bg", 4.5],
    ["muted", "panel", 4.5],
    ["muted", "sidebar", 4.5],
    ["ink", "sidebar-active", 4.5],
    ["on-accent", "accent", 4.5],
    ["fail", "bg", 4.5],
    ["warn", "bg", 4.5],
    ["accent", "bg", 3],
    ["line", "bg", 1.0],
    ["ink", "diff-add", 4.5],
    ["ink", "diff-del", 4.5]
  ]
}
