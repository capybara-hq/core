{
  "version": 1,
  "color": {
    "bg": { "dark": "#0A0A0A", "light": "#FAF9F6", "purpose": "Page background" },
    "panel": { "dark": "#111110", "light": "#FFFFFF", "purpose": "Cards, table container, stat cards, form field cards, overlays" },
    "panel-2": { "dark": "#0E0E0D", "light": "#FCFBF9", "purpose": "Action row, right-panel ground" },
    "sidebar": { "dark": "#111110", "light": "#F3F2EE", "purpose": "Sidebar ground" },
    "sidebar-active": { "dark": "#1A1A18", "light": "rgba(26,26,24,0.09)", "purpose": "Current nav item or conversation in the sidebar" },
    "raised": { "dark": "#141413", "light": "#FFFFFF", "purpose": "Floating inline cards, the composer" },
    "selected": { "dark": "#1F1F1D", "light": "rgba(26,26,24,0.07)", "purpose": "Selected segment, filter chip, option card, palette row and waterfall row ground, avatar" },
    "hover": { "dark": "#171716", "light": "rgba(26,26,24,0.04)", "purpose": "Hover ground" },
    "line-soft": { "dark": "#1C1C1A", "light": "#E8E7E2", "purpose": "Column dividers, table row dividers, the status bar's top line" },
    "line": { "dark": "#2A2A28", "light": "#D9D8D2", "purpose": "Input and button border" },
    "line-strong": { "dark": "#3A3A37", "light": "#B5B5AE", "purpose": "Overlay border, the border of a selected card or row" },
    "line-card": { "dark": "rgba(255,255,255,0.08)", "light": "rgba(26,26,24,0.07)", "purpose": "Card and section hairline" },
    "scroll-thumb": { "dark": "rgba(255,255,255,0.15)", "light": "rgba(26,26,24,0.20)", "purpose": "Scrollbar thumb" },
    "ink": { "dark": "#E6E6E3", "light": "#1A1A18", "purpose": "Text" },
    "muted": { "dark": "#8E8E89", "light": "#5E5E5A", "purpose": "Secondary text, sidebar group labels" },
    "faint": { "dark": "#5A5A56", "light": "#9A9A94", "purpose": "Placeholders and separators only, never essential text" },
    "disabled": { "dark": "#6E6E69", "light": "#82827C", "purpose": "Disabled text and icons (3:1 on every ground a control sits on)" },
    "accent": { "dark": "#FF6A13", "light": "#CC4609", "purpose": "Primary action, focus, current navigation (spec §2.3)" },
    "accent-hover": { "dark": "#FF8240", "light": "#B83F08", "purpose": "Accent hover" },
    "accent-press": { "dark": "#E85A08", "light": "#A33707", "purpose": "Accent pressed" },
    "on-accent": { "dark": "#0A0A0A", "light": "#FFFFFF", "purpose": "Text on accent" },
    "accent-tint": {
      "dark": "color-mix(in srgb, var(--cb-accent) 12%, transparent)",
      "light": "color-mix(in srgb, var(--cb-accent) 12%, transparent)",
      "purpose": "Tinted accent ground"
    },
    "focus-ring": { "dark": "rgba(255,106,19,.25)", "light": "rgba(204,70,9,.18)", "purpose": "3px input focus halo" },
    "ok": { "dark": "#3FD483", "light": "#16803F", "purpose": "Success (rarely shown: success is not colored, spec §4.2.2)" },
    "fail": { "dark": "#FF5C52", "light": "#C8302A", "purpose": "Failure" },
    "warn": { "dark": "#F2C14B", "light": "#8F6500", "purpose": "Needs a person" },
    "scrim": { "dark": "rgba(0,0,0,.60)", "light": "rgba(10,10,10,.25)", "purpose": "Behind dialogs and sheets" },
    "diff-add": { "dark": "rgba(63,212,131,.08)", "light": "rgba(22,128,63,.10)", "purpose": "Added lines in a diff" },
    "diff-del": { "dark": "rgba(255,92,82,.08)", "light": "rgba(207,34,46,.08)", "purpose": "Removed lines in a diff" },
    "avatar-black": { "dark": "#1C1C1A", "light": "#1C1C1A", "purpose": "Agent avatars only (§3): black fur and feathers, eyes, noses" },
    "avatar-white": { "dark": "#F2F2EE", "light": "#FFFFFF", "purpose": "Agent avatars only (§3): white faces, bellies, eyes" },
    "avatar-capybara-ground": { "dark": "#3D2213", "light": "#FBE3D2", "purpose": "Agent avatars only (§3): the capybara's ground" },
    "avatar-black-bear-ground": { "dark": "#9C8468", "light": "#E6D6C1", "purpose": "Agent avatars only (§3): the black bear's ground" },
    "avatar-black-bear-snout": { "dark": "#C9A074", "light": "#C49A6C", "purpose": "Agent avatars only (§3): the black bear's snout" },
    "avatar-panda-ground": { "dark": "#5E9168", "light": "#669D71", "purpose": "Agent avatars only (§3): the panda's ground" },
    "avatar-elephant-ground": { "dark": "#2A2838", "light": "#E6E3F2", "purpose": "Agent avatars only (§3): the elephant's ground" },
    "avatar-elephant": { "dark": "#9AA0A8", "light": "#757B84", "purpose": "Agent avatars only (§3): the elephant's body" },
    "avatar-elephant-ear": { "dark": "#7D838C", "light": "#5A6068", "purpose": "Agent avatars only (§3): the elephant's ear" },
    "avatar-fox-ground": { "dark": "#3A2414", "light": "#FCEBD9", "purpose": "Agent avatars only (§3): the fox's ground" },
    "avatar-fox": { "dark": "#F07A2E", "light": "#D8601A", "purpose": "Agent avatars only (§3): the fox's body" },
    "avatar-fox-ear": { "dark": "#8A3E16", "light": "#7A3310", "purpose": "Agent avatars only (§3): the fox's ear" },
    "avatar-owl-ground": { "dark": "#2E2618", "light": "#EFE6D4", "purpose": "Agent avatars only (§3): the owl's ground" },
    "avatar-owl": { "dark": "#B07D52", "light": "#875A36", "purpose": "Agent avatars only (§3): the owl's body" },
    "avatar-owl-belly": { "dark": "#D9B68C", "light": "#D9B68C", "purpose": "Agent avatars only (§3): the owl's belly" },
    "avatar-owl-eye": { "dark": "#F5C542", "light": "#F5C542", "purpose": "Agent avatars only (§3): the owl's eye" },
    "avatar-beak": { "dark": "#EE8A2A", "light": "#EE8A2A", "purpose": "Agent avatars only (§3): the owl's and penguin's beak and feet" },
    "avatar-penguin-ground": { "dark": "#5F8AAD", "light": "#6692B6", "purpose": "Agent avatars only (§3): the penguin's ground" },
    "avatar-rabbit-ground": { "dark": "#3A2229", "light": "#F8DDE3", "purpose": "Agent avatars only (§3): the rabbit's ground" },
    "avatar-rabbit": { "dark": "#B89A84", "light": "#8F725C", "purpose": "Agent avatars only (§3): the rabbit's body" },
    "avatar-rabbit-pink": { "dark": "#F2A7B5", "light": "#F2A7B5", "purpose": "Agent avatars only (§3): the rabbit's pink" },
    "avatar-turtle-ground": { "dark": "#2E2A18", "light": "#F2E8C9", "purpose": "Agent avatars only (§3): the turtle's ground" },
    "avatar-turtle": { "dark": "#5FA548", "light": "#4E8F3A", "purpose": "Agent avatars only (§3): the turtle's body" },
    "avatar-turtle-shell": { "dark": "#3B7330", "light": "#2F5E24", "purpose": "Agent avatars only (§3): the turtle's shell" },
    "avatar-turtle-skin": { "dark": "#A8C66C", "light": "#9FBF62", "purpose": "Agent avatars only (§3): the turtle's skin" },
    "avatar-whale-ground": { "dark": "#16283A", "light": "#DCEFF5", "purpose": "Agent avatars only (§3): the whale's ground" },
    "avatar-whale": { "dark": "#5A92D6", "light": "#3A72B5", "purpose": "Agent avatars only (§3): the whale's body" },
    "avatar-whale-belly": { "dark": "#DCEAF5", "light": "#FFFFFF", "purpose": "Agent avatars only (§3): the whale's belly" },
    "avatar-whale-spout": { "dark": "#8EC3E8", "light": "#8EC3E8", "purpose": "Agent avatars only (§3): the whale's spout" }
  },
  "shadow": {
    "shadow-1": { "dark": "0 8px 24px rgba(0,0,0,.40)", "light": "0 2px 8px rgba(10,10,10,.08)", "purpose": "Popovers, menus" },
    "shadow-2": { "dark": "0 16px 48px rgba(0,0,0,.50)", "light": "0 8px 24px rgba(10,10,10,.12)", "purpose": "Dialogs" },
    "shadow-sheet": { "dark": "-16px 0 40px rgba(0,0,0,.40)", "light": "-4px 0 16px rgba(10,10,10,.08)", "purpose": "Side sheets" },
    "shadow-float": { "dark": "0 8px 24px rgba(0,0,0,.45)", "light": "0 8px 24px rgba(26,26,24,.08)", "purpose": "The composer, the sidebar drawer" }
  },
  "size": {
    "control": { "dense": 24, "default": 28, "prominent": 32 },
    "row": { "dense": 28, "default": 32, "roomy": 44 },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40 },
    "pad": { "dense": [4, 8], "default": [6, 12] },
    "radius": { "sm": 4, "md": 8, "bubble": 10 },
    "type": {
      "micro": [11, 14],
      "small": [12, 16],
      "body": [13, 20],
      "h2": [16, 24],
      "h1": [20, 28],
      "prose": [15, 26],
      "prose-small": [13, 20],
      "metric": [18, 24]
    },
    "layout": {
      "sidebar": 256,
      "sidebar-rail": 48,
      "content": 1120,
      "content-pad": 32,
      "chat": 720,
      "status-bar": 24,
      "action-row": 40,
      "gutter": 20,
      "title-bar": 48,
      "properties": 300,
      "panel-min": 520,
      "panel": 560,
      "chat-min": 480,
      "tool-output": 120,
      "file-card": 240,
      "thumb": 56,
      "inline-image": 360,
      "menu-max-height": 328,
      "bubble-clamp": 208,
      "head-path": 12,
      "head-description": 4,
      "head-tabs": 16,
      "head-tabs-content": 16,
      "head-content": 24
    }
  },
  "motion": { "hover": "120ms", "expand": "160ms", "overlay": "120ms", "cursor": "1000ms", "spin": "800ms", "pulse": "1600ms" },
  "font": {
    "mono": "\"Sarasa Mono SC\", ui-monospace, monospace",
    "prose": "\"Inter\", \"Source Han Sans SC\", system-ui, sans-serif"
  },
  "z": { "sheet": 40, "dialog": 50, "popover": 60, "toast": 70 },
  "contrast": [
    ["ink", "bg", 4.5],
    ["muted", "bg", 4.5],
    ["muted", "panel", 4.5],
    ["muted", "sidebar", 4.5],
    ["muted", "panel-2", 4.5],
    ["muted", "raised", 4.5],
    ["muted", "selected", 4.5],
    ["muted", "hover", 4.5],
    ["disabled", "bg", 3],
    ["disabled", "panel", 3],
    ["disabled", "hover", 3],
    ["disabled", "selected", 3],
    ["ink", "sidebar-active", 4.5],
    ["muted", "selected", 4.5, "sidebar"],
    ["muted", "hover", 4.5, "sidebar"],
    ["ink", "sidebar-active", 4.5, "sidebar"],
    ["on-accent", "accent", 4.5],
    ["fail", "bg", 4.5],
    ["warn", "bg", 4.5],
    ["accent", "bg", 3],
    ["line", "bg", 1.0],
    ["ink", "diff-add", 4.5],
    ["ink", "diff-del", 4.5],
    ["accent", "avatar-capybara-ground", 3],
    ["avatar-black", "avatar-black-bear-ground", 3],
    ["avatar-black", "avatar-panda-ground", 3],
    ["avatar-elephant", "avatar-elephant-ground", 3],
    ["avatar-fox", "avatar-fox-ground", 3],
    ["avatar-owl", "avatar-owl-ground", 3],
    ["avatar-black", "avatar-penguin-ground", 3],
    ["avatar-rabbit", "avatar-rabbit-ground", 3],
    ["avatar-turtle", "avatar-turtle-ground", 3],
    ["avatar-whale", "avatar-whale-ground", 3],
    ["avatar-white", "avatar-panda-ground", 3],
    ["avatar-white", "avatar-penguin-ground", 3]
  ],
  "separation": [
    ["hover", "bg", 2.5],
    ["hover", "panel", 2.5],
    ["hover", "sidebar", 2.5],
    ["selected", "bg", 2.5],
    ["selected", "panel", 2.5],
    ["selected", "sidebar", 2.5],
    ["sidebar-active", "sidebar", 2.5]
  ]
}
