+.cb-avatar-tile:hover {
+  background: var(--cb-hover);
+}
+.cb-avatar-tile[data-state="checked"] {
+  border-color: var(--cb-line-strong);
+  background: var(--cb-selected);
+}
+.cb-avatar-tile:focus-visible,
+.cb-avatar-tile:has(.cb-avatar-radio:focus-visible) {
+  outline: 2px solid var(--cb-accent);
+  outline-offset: 2px;
+}
+.cb-avatar-radio {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  margin: 0;
+  opacity: 0;
+  cursor: inherit;
+}
+.cb-avatar-tile[data-part="avatar-upload"][data-state="unchecked"] {
+  border: 1px dashed var(--cb-line);
+}
+.cb-avatar-tile[data-part="avatar-upload"]:disabled {
+  border-color: var(--cb-line-soft);
+  background: transparent;
+  color: var(--cb-disabled);
+  cursor: not-allowed;
+}
+.cb-avatar-picker-reason {
+  margin: 0;
+  color: var(--cb-muted);
+  font-size: var(--cb-type-small-size);
+  line-height: var(--cb-type-small-line);
+}
