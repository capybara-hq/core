+    agent("ag1", "Alpha", { quickActions: [qa("Summarize"), qa("Translate")] }),
+    agent("ag2", "Beta", {
+      quickActions: [qa("Plan"), qa("Review"), qa("Draft"), qa("Polish"), qa("Ship")],
