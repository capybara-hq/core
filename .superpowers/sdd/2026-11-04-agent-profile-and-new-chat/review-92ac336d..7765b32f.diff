+  activeNav: "",
+  account: { name: "Grant", menu: [] },
+  onOpenCommands: () => {},
+};
+
+function SidebarHarness() {
+  const conversations = useConversationGroups("o1", "/");
+  return <Sidebar {...sidebarBase} conversations={conversations} mode="full" />;
+}
