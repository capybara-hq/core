@@ -0,0 +1,103 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import { useTranslations } from "next-intl";
+import { useState } from "react";
+import { channelsQuery } from "../../lib/query/channels";
+import { retryOnMountOf } from "../../lib/query/client";
+import { AgentChannels } from "../AgentChannels";
+import {
+  type AgentFormData,
+  type AgentFormSection,
+  useAgentForm,
+  useAgentFormData,
+} from "../AgentForm";
+import { ErrorFrame } from "../ErrorFrame";
+import { AgentSectionFrame, useAgentPage } from "./frame";
+import type { AgentSection } from "./sections";
+
+/**
+ * The sections the agent form still draws (prompt, model, tools, skills, sub-agents) and the
+ * channels, until Task 7 gives each its own component. A form section saves only its own edits:
+ * the form opens on the saved agent and draws only that section, so the rest of the definition it
+ * sends is the saved one (with `expectedVersion`).
+ */
+export function LegacyFormSection({
+  section,
+}: {
+  section: Exclude<AgentSection, "basics" | "quick-actions">;
+}) {
+  if (section === "channels") return <ChannelsSection />;
+  return <FormSectionBody section={section} />;
+}
+
+function ChannelsSection() {
+  const { orgId, agent } = useAgentPage();
+  const q = channelsQuery(orgId);
+  const channels = useQuery({ ...q, retryOnMount: retryOnMountOf(q.queryKey) });
+  if (channels.data === undefined && channels.error === null) {
+    return <AgentSectionFrame loading />;
+  }
+  return (
+    <AgentSectionFrame>
+      <AgentChannels
+        agentId={agent.id}
+        channels={channels.data?.channels.filter((c) => c.agentId === agent.id) ?? null}
+      />
+    </AgentSectionFrame>
+  );
+}
+
+function FormSectionBody({ section }: { section: AgentFormSection }) {
+  const { orgId, agent } = useAgentPage();
+  const state = useAgentFormData(orgId, agent.id);
+  // a save or a discard opens the form again on the saved agent
+  const [round, setRound] = useState(0);
+  if (state.kind === "error") return <ErrorFrame reset={state.retry} />;
+  if (state.kind === "loading") return <AgentSectionFrame loading />;
+  return (
+    <SectionForm
+      key={`${agent.currentVersion}-${round}`}
+      section={section}
+      data={state.data}
+      onReset={() => setRound((r) => r + 1)}
+    />
+  );
+}
+
+function SectionForm({
+  section,
+  data,
+  onReset,
+}: {
+  section: AgentFormSection;
+  data: AgentFormData;
+  onReset(): void;
+}) {
+  const t = useTranslations();
+  const { orgId, agent } = useAgentPage();
+  const form = useAgentForm(orgId, onReset, data, agent, section);
+  const dirty = !form.saved && form.unsaved > 0;
+  return (
+    <AgentSectionFrame
+      dirty={dirty}
+      actionRow={
+        form.saved
+          ? { primary: { label: t("agents.form.continue"), onSelect: onReset } }
+          : {
+              unsaved: form.unsaved,
+              errors: form.errors,
+              ...(dirty ? { cancel: { label: t("agents.page.discard"), onSelect: onReset } } : {}),
+              primary: {
+                label: t("agents.form.submit"),
+                onSelect: form.submit,
+                loading: form.pending,
+                disabled: !form.canSubmit,
+              },
+            }
+      }
+    >
+      {form.sections}
+    </AgentSectionFrame>
+  );
+}
diff --git a/apps/web/src/components/agent/ModelReadOnly.tsx b/apps/web/src/components/agent/ModelReadOnly.tsx
new file mode 100644
index 00000000..e416bb80
--- /dev/null
+++ b/apps/web/src/components/agent/ModelReadOnly.tsx
@@ -0,0 +1,36 @@
+"use client";
+
+import { FormSection, KeyValue } from "@capybara-hq/design";
+import { useTranslations } from "next-intl";
+import { modelLabel } from "../../lib/extension-label";
+import { AgentSectionFrame, useAgentPage } from "./frame";
+
+/**
+ * The Model section for someone who may not change the agent (B3): the model and the fallback,
+ * read-only. Without the providers list (they read only the agent) the provider id stands in.
+ */
+export function ModelReadOnly() {
+  const t = useTranslations("agents");
+  const { agent } = useAgentPage();
+  const d = agent.definition;
+  return (
+    <AgentSectionFrame>
+      <FormSection id="model" title={t("page.sections.model")}>
+        <KeyValue
+          rows={[
+            {
+              k: t("form.modelLabel"),
+              v: modelLabel({ name: d.model.provider }, d.model.model, "en"),
+            },
+            {
+              k: t("form.fallbackLabel"),
+              v: !d.fallback
+                ? t("form.fallbackNone")
+                : modelLabel({ name: d.fallback.provider }, d.fallback.model, "en"),
+            },
+          ]}
+        />
+      </FormSection>
+    </AgentSectionFrame>
+  );
+}
diff --git a/apps/web/src/components/agent/QuickActionsSection.tsx b/apps/web/src/components/agent/QuickActionsSection.tsx
new file mode 100644
index 00000000..fdfcbdcd
--- /dev/null
+++ b/apps/web/src/components/agent/QuickActionsSection.tsx
@@ -0,0 +1,252 @@
+"use client";
+
+import {
+  Callout,
+  Card,
+  Field,
+  FormSection,
+  Input,
+  Repeater,
+  Stack,
+  Text,
+  Textarea,
+} from "@capybara-hq/design";
+import { useQueryClient } from "@tanstack/react-query";
+import { useTranslations } from "next-intl";
+import { useRef, useState } from "react";
+import type { Agent, QuickAction } from "../../lib/agents";
+import { ApiClientError } from "../../lib/api";
+import { keys } from "../../lib/query/keys";
+import { useUpdateProfile } from "../../lib/query/mutation";
+import { useErrorMessage } from "../../lib/use-error-message";
+import { FormError } from "../form-error";
+import { CONFLICT_CODES } from "./BasicsSection";
+import { AgentSectionFrame, useAgentPage } from "./frame";
+import { useSectionDraft } from "./useSectionDraft";
+
+/** The profile limits (agent profile design §2.1). */
+export const QUICK_ACTIONS_MAX = 9;
+const TITLE_MAX = 40;
+const BODY_MAX = 20_000;
+
+type Entry = QuickAction & { key: string };
+type Draft = { items: Entry[] };
+
+const draftOf = (a: Agent): Draft => ({
+  items: a.profile.quickActions.map((q, i) => ({ key: `saved-${i}`, ...q })),
+});
+/** What a draft saves: the entries in order, without their keys. */
+const actionsOf = (d: Draft): QuickAction[] => d.items.map(({ title, body }) => ({ title, body }));
+
+/**
+ * 快捷操作 Quick actions (agent profile design §3.2): up to 9 title + body entries; add, edit,
+ * delete, reorder; saved through the profile with its `updatedAt`, so a second tab's save is a 409
+ * with a reload, never a silent overwrite. Read-only for someone who may not change the agent.
+ */
+export function QuickActionsSection() {
+  const { editable } = useAgentPage();
+  return editable ? <QuickActionsEdit /> : <QuickActionsReadOnly />;
+}
+
+function QuickActionsReadOnly() {
+  const t = useTranslations("agents.page");
+  const { agent } = useAgentPage();
+  const list = agent.profile.quickActions;
+  return (
+    <AgentSectionFrame>
+      <FormSection id="quick-actions" title={t("sections.quick-actions")}>
+        {list.length === 0 ? (
+          <Text tone="muted">{t("quickActions.none")}</Text>
+        ) : (
+          <Stack gap={12}>
+            {list.map((q, i) => (
+              // biome-ignore lint/suspicious/noArrayIndexKey: titles may repeat; the order is the identity
+              <Card key={i} title={q.title}>
+                <Text variant="prose">{q.body}</Text>
+              </Card>
+            ))}
+          </Stack>
+        )}
+      </FormSection>
+    </AgentSectionFrame>
+  );
+}
+
+function QuickActionsEdit() {
+  const t = useTranslations("agents.page");
+  const tf = useTranslations("agents.form");
+  const qc = useQueryClient();
+  const errorMessage = useErrorMessage();
+  const { orgId, agent } = useAgentPage();
+  const saved = draftOf(agent);
+  const draft = useSectionDraft(saved);
+  const [base, setBase] = useState<string | null>(null);
+  const [error, setError] = useState<unknown>(null);
+  const [checked, setChecked] = useState(false);
+  const [pending, setPending] = useState(false);
+  const next = useRef(0);
+  const update = useUpdateProfile(orgId, agent.id);
+
+  const edit = (fn: (d: Draft) => Draft) => {
+    if (!draft.dirty) setBase(agent.profile.updatedAt);
+    draft.set(fn);
+  };
+  const items = draft.draft.items;
+  const invalid = (e: Entry) => ({
+    title: e.title.trim() === "",
+    body: e.body.trim() === "",
+  });
+  const errors = checked
+    ? items.filter((e) => invalid(e).title || invalid(e).body).length + (error ? 1 : 0)
+    : error
+      ? 1
+      : 0;
+  const savedJson = JSON.stringify(actionsOf(saved));
+  const unsaved = draft.dirty && JSON.stringify(actionsOf(draft.draft)) !== savedJson ? 1 : 0;
+
+  async function save() {
+    if (pending) return;
+    setChecked(true);
+    if (items.some((e) => invalid(e).title || invalid(e).body)) return;
+    setPending(true);
+    setError(null);
+    try {
+      await update.mutateAsync({
+        quickActions: actionsOf(draft.draft),
+        expectedUpdatedAt: base ?? agent.profile.updatedAt,
+      });
+      draft.reset();
+      setBase(null);
+      setChecked(false);
+    } catch (e) {
+      setError(e);
+    } finally {
+      setPending(false);
+    }
+  }
+
+  function discard() {
+    draft.reset();
+    setBase(null);
+    setError(null);
+    setChecked(false);
+  }
+
+  async function reload() {
+    await qc.refetchQueries({ queryKey: keys.org(orgId).agent(agent.id) });
+    discard();
+  }
+
+  const conflict = error instanceof ApiClientError && CONFLICT_CODES.has(error.code);
+  return (
+    <AgentSectionFrame
+      dirty={unsaved > 0}
+      actionRow={{
+        unsaved,
+        errors,
+        ...(unsaved > 0 ? { cancel: { label: t("discard"), onSelect: discard } } : {}),
+        primary: {
+          label: tf("submit"),
+          onSelect: () => void save(),
+          loading: pending,
+          disabled: pending || unsaved === 0,
+        },
+      }}
+    >
+      <Stack gap={16}>
+        {error ? (
+          conflict ? (
+            <Callout tone="fail" action={{ label: t("reload"), onSelect: () => void reload() }}>
+              {errorMessage(error)}
+            </Callout>
+          ) : (
+            <FormError message={errorMessage(error)} />
+          )
+        ) : null}
+        <FormSection
+          id="quick-actions"
+          title={t("sections.quick-actions")}
+          description={t("quickActions.hint", { max: QUICK_ACTIONS_MAX })}
+        >
+          <Repeater
+            label={t("quickActions.list")}
+            addLabel={t("quickActions.add")}
+            max={QUICK_ACTIONS_MAX}
+            empty={t("quickActions.none")}
+            items={items.map((e) => {
+              const bad = checked ? invalid(e) : { title: false, body: false };
+              return {
+                key: e.key,
+                title: e.title,
+                invalid: bad.title || bad.body,
+                body: (
+                  <Stack gap={12}>
+                    <Field
+                      label={t("quickActions.titleLabel")}
+                      required
+                      count={{ value: e.title.length, max: TITLE_MAX }}
+                      {...(bad.title ? { error: t("quickActions.titleRequired") } : {})}
+                    >
+                      <Input
+                        maxLength={TITLE_MAX}
+                        value={e.title}
+                        onChange={(ev) => {
+                          const title = ev.target.value;
+                          edit((d) => ({
+                            items: d.items.map((x) => (x.key === e.key ? { ...x, title } : x)),
+                          }));
+                        }}
+                      />
+                    </Field>
+                    <Field
+                      label={t("quickActions.bodyLabel")}
+                      required
+                      help={t("quickActions.bodyHelp")}
+                      {...(bad.body ? { error: t("quickActions.bodyRequired") } : {})}
+                    >
+                      <Textarea
+                        rows={4}
+                        maxLength={BODY_MAX}
+                        value={e.body}
+                        onChange={(ev) => {
+                          const body = ev.target.value;
+                          edit((d) => ({
+                            items: d.items.map((x) => (x.key === e.key ? { ...x, body } : x)),
+                          }));
+                        }}
+                      />
+                    </Field>
+                  </Stack>
+                ),
+              };
+            })}
+            onAdd={() => {
+              next.current += 1;
+              const key = `new-${next.current}`;
+              edit((d) =>
+                d.items.length >= QUICK_ACTIONS_MAX
+                  ? d
+                  : { items: [...d.items, { key, title: "", body: "" }] },
+              );
+            }}
+            onRemove={(key) => {
+              const before = items;
+              edit((d) => ({ items: d.items.filter((x) => x.key !== key) }));
+              return () => edit(() => ({ items: before }));
+            }}
+            onMove={(key, to) =>
+              edit((d) => {
+                const from = d.items.findIndex((x) => x.key === key);
+                if (from < 0) return d;
+                const list = [...d.items];
+                const [moved] = list.splice(from, 1);
+                if (moved) list.splice(to, 0, moved);
+                return { items: list };
+              })
+            }
+          />
+        </FormSection>
+      </Stack>
+    </AgentSectionFrame>
+  );
+}
diff --git a/apps/web/src/components/agent/frame.tsx b/apps/web/src/components/agent/frame.tsx
new file mode 100644
index 00000000..ad507559
--- /dev/null
+++ b/apps/web/src/components/agent/frame.tsx
@@ -0,0 +1,92 @@
+"use client";
+
+import { type ActionRowProps, type PageHeaderProps, SettingsPage } from "@capybara-hq/design";
+import { useTranslations } from "next-intl";
+import { createContext, type ReactNode, useContext, useEffect } from "react";
+import type { Agent } from "../../lib/agents";
+import {
+  type AgentSection,
+  READ_ONLY_FIELDS,
+  SECTION_FIELDS,
+  sectionHref,
+  sectionsFor,
+} from "./sections";
+
+/** What every section of the agent page reads: the agent, who is looking, the open section. */
+export interface AgentPageValue {
+  orgId: string;
+  agent: Agent;
+  /** The viewer may change the agent (owner or org admin); else every section is read-only. */
+  editable: boolean;
+  section: AgentSection;
+  header: PageHeaderProps;
+  nav: { group: string; items: { id: string; label: string; href: string }[] }[];
+  /** A section reports its unsaved edits, so leaving it asks first. */
+  setDirty(dirty: boolean): void;
+}
+
+export const AgentPageContext = createContext<AgentPageValue | null>(null);
+
+/** The agent page's context; only inside {@link AgentPage}. */
+export function useAgentPage(): AgentPageValue {
+  const v = useContext(AgentPageContext);
+  if (v === null) throw new Error("useAgentPage outside AgentPage");
+  return v;
+}
+
+/** The nav of the sections this viewer sees. */
+export function useSectionNav(agentId: string, editable: boolean) {
+  const t = useTranslations("agents.page");
+  return [
+    {
+      group: t("navGroup"),
+      items: sectionsFor(editable).map((s) => ({
+        id: s,
+        label: t(`sections.${s}`),
+        href: sectionHref(agentId, s),
+      })),
+    },
+  ];
+}
+
+/**
+ * One section of the agent page: the `SettingsPage` template with the page's head and section
+ * nav, the section's content, and its own action row (Save, Discard) while it has changes.
+ * `dirty` tells the page the section holds unsaved edits; `loading` draws the section's static
+ * field layout while its reads are on the way.
+ */
+export function AgentSectionFrame({
+  actionRow,
+  dirty = false,
+  loading = false,
+  children,
+}: {
+  actionRow?: ActionRowProps | undefined;
+  dirty?: boolean;
+  loading?: boolean;
+  children?: ReactNode;
+}) {
+  const page = useAgentPage();
+  const t = useTranslations("agents.page");
+  const { setDirty } = page;
+  useEffect(() => {
+    setDirty(dirty);
+    return () => setDirty(false);
+  }, [dirty, setDirty]);
+  const fields = page.editable
+    ? SECTION_FIELDS[page.section]
+    : (READ_ONLY_FIELDS[page.section] ?? SECTION_FIELDS[page.section]);
+  return (
+    <SettingsPage
+      header={page.header}
+      nav={page.nav}
+      activeNav={page.section}
+      {...(actionRow ? { actionRow } : {})}
+      {...(loading
+        ? { loading: { sections: [{ fields, title: t(`sections.${page.section}`) }] } }
+        : {})}
+    >
+      {children}
+    </SettingsPage>
+  );
+}
diff --git a/apps/web/src/components/agent/sections.ts b/apps/web/src/components/agent/sections.ts
new file mode 100644
index 00000000..478951ae
--- /dev/null
+++ b/apps/web/src/components/agent/sections.ts
@@ -0,0 +1,70 @@
+import type { FieldShape } from "@capybara-hq/design";
+
+/**
+ * The agent page's sections (agent profile design §3.2), in nav order. The URL keeps the open one
+ * as `/agents/<id>?s=<section>`; without `s` (or with an unknown one) the page opens `basics`.
+ */
+export const AGENT_SECTIONS = [
+  "basics",
+  "quick-actions",
+  "prompt",
+  "model",
+  "tools",
+  "skills",
+  "subagents",
+  "channels",
+] as const;
+
+export type AgentSection = (typeof AGENT_SECTIONS)[number];
+
+/**
+ * What someone who may use but not change the agent sees (§3.2, builder check B3), read-only:
+ * the prompt files, tools, skills, sub-agents and channels stay hidden from them.
+ */
+export const READ_ONLY_SECTIONS: readonly AgentSection[] = ["basics", "quick-actions", "model"];
+
+const isSection = (s: string): s is AgentSection =>
+  (AGENT_SECTIONS as readonly string[]).includes(s);
+
+/** The sections the viewer's nav lists. */
+export const sectionsFor = (editable: boolean): readonly AgentSection[] =>
+  editable ? AGENT_SECTIONS : READ_ONLY_SECTIONS;
+
+/** The section `?s=` opens for this viewer: an unknown or hidden one opens `basics`. */
+export function sectionOf(s: string | undefined, editable: boolean): AgentSection {
+  if (s === undefined || !isSection(s)) return "basics";
+  return sectionsFor(editable).includes(s) ? s : "basics";
+}
+
+/** The URL of a section of the agent page. */
+export const sectionHref = (agentId: string, s: AgentSection) =>
+  `/agents/${encodeURIComponent(agentId)}?s=${s}`;
+
+/**
+ * Each section's static field layout, for the template's loading state (`SettingsPage
+ * loading.sections`), so the skeleton sits in the loaded section's boxes. Lists and checkbox
+ * groups count as one field each.
+ */
+export const SECTION_FIELDS: Record<AgentSection, FieldShape[]> = {
+  // the avatar tiles, name, description, visibility
+  basics: [
+    { control: "radios", options: 11 },
+    { control: "input" },
+    { control: "textarea", rows: 3 },
+    { control: "select" },
+  ],
+  "quick-actions": [{ control: "card-group", options: 2 }],
+  prompt: [{ control: "textarea", rows: 6, help: true }],
+  model: [{ control: "select" }, { control: "select" }],
+  tools: [{ control: "card-group", options: 2 }],
+  skills: [{ control: "card-group", options: 2 }],
+  subagents: [{ control: "card-group", options: 1 }],
+  channels: [{ control: "card-group", options: 1 }],
+};
+
+/** The read-only variant's field layout (key-value rows, or the quick-action cards). */
+export const READ_ONLY_FIELDS: Partial<Record<AgentSection, FieldShape[]>> = {
+  basics: [{ control: "text" }, { control: "key-value" }],
+  "quick-actions": [{ control: "card-group", options: 2 }],
+  model: [{ control: "key-value" }],
+};
