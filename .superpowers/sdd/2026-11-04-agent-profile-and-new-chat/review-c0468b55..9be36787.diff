+  const save = useDefinitionSave();
+  const actionRow = useSectionActionRow();
+  const saved = draftOf(agent);
+  const draft = useSectionDraft(saved);
+  const [fieldErrors, setFieldErrors] = useState<FieldErrors>(NO_FIELD_ERRORS);
+  const [otherErrors, setOtherErrors] = useState<string[]>([]);
+  const providers = data.providers;
+  const d = draft.draft;
+
+  const declOf = (v: string): ModelParameter[] => {
+    const ref = decodeModel(v);
+    return (ref && findModel(providers, ref)?.parameters) || [];
+  };
+  const modelDecl = declOf(d.model);
+  const fallbackDecl = declOf(d.fallback);
+  const edit = (fn: (cur: Draft) => Draft) => {
+    save.begin();
+    draft.set(fn);
+  };
+
+  const options = providers.flatMap((p) =>
+    p.models.map((m) => ({
+      value: encodeModel({ provider: p.provider, model: m.id }),
+      label: modelLabel(
+        { name: p.provider, displayName: p.displayName },
+        m.displayName || m.id,
+        lang,
+      ),
+    })),
+  );
+  const noModels = options.length === 0;
+
+  /** `validation_failed` details on the params fields; the ones no field shows are listed. */
+  function showDetails(err: unknown) {
+    if (!(err instanceof ApiClientError) || err.code !== "validation_failed") return;
+    const decl: Record<ParamField, ModelParameter[]> = {
+      modelParams: modelDecl,
+      fallbackParams: fallbackDecl,
+    };
+    const fields: FieldErrors = { modelParams: {}, fallbackParams: {} };
+    const others: string[] = [];
+    for (const x of err.details) {
+      const dot = x.path.indexOf(".");
+      if (dot < 0) continue;
+      const field = x.path.slice(0, dot) as ParamField;
+      const key = x.path.slice(dot + 1);
+      if (!Object.hasOwn(fields, field)) continue;
+      if (decl[field].some((p) => p.key === key)) fields[field][key] = t("params.invalid");
+      else others.push(t("params.invalidKey", { key }));
+    }
+    setFieldErrors(fields);
+    setOtherErrors(others);
+  }
+
+  const unsaved = [
+    d.model !== saved.model,
+    d.fallback !== saved.fallback,
+    !sameJson(d.modelParams, saved.modelParams),
+    !sameJson(d.fallbackParams, saved.fallbackParams),
+  ].filter(Boolean).length;
+
+  async function onSave() {
+    if (save.pending || noModels) return;
+    const main = decodeModel(d.model);
+    if (main === null) return;
+    const fb = decodeModel(d.fallback);
+    setFieldErrors(NO_FIELD_ERRORS);
+    setOtherErrors([]);
+    const r = await save.send({
+      ...savedDefinition(agent),
+      model: main,
+      fallback: fb,
+      modelParams: d.modelParams,
+      fallbackParams: fb === null ? {} : d.fallbackParams,
+    });
+    if (r.saved) draft.reset();
+    else showDetails(r.error);
+  }
+
+  function discard() {
+    draft.reset();
+    save.clear();
+    setFieldErrors(NO_FIELD_ERRORS);
+    setOtherErrors([]);
+  }
+
+  const errors =
+    Object.keys(fieldErrors.modelParams).length +
+    Object.keys(fieldErrors.fallbackParams).length +
+    otherErrors.length +
+    (save.error ? 1 : 0);
+  return (
+    <AgentSectionFrame
+      dirty={draft.dirty}
+      actionRow={actionRow({
+        unsaved,
+        errors,
+        pending: save.pending,
+        onDiscard: discard,
+        onSave: () => void onSave(),
+        disabled: noModels,
+      })}
+    >
+      <Stack gap={16}>
+        <SaveFeedback save={save} onReload={() => void save.reload(discard)} extra={otherErrors} />
+        <div>
+          <FormSection
+            id="model"
+            title={t("form.modelSection")}
+            description={t("form.modelSectionHint")}
+          >
+            <Field
+              label={t("form.modelLabel")}
+              required
+              {...(noModels ? { error: t("form.noModels") } : {})}
+            >
+              <Select
+                name="model"
+                disabled={noModels || save.pending}
+                value={d.model}
+                onChange={(e) => {
+                  const v = e.target.value;
+                  edit((cur) => ({
+                    ...cur,
+                    model: v,
+                    modelParams: keepDeclared(declOf(v), cur.modelParams),
+                  }));
+                  setFieldErrors((x) => ({ ...x, modelParams: {} }));
+                }}
+                options={options}
+              />
+            </Field>
+            <Field label={t("form.fallbackLabel")} optional>
+              <Select
+                name="fallback"
+                disabled={save.pending}
+                value={d.fallback}
+                onChange={(e) => {
+                  const v = e.target.value;
+                  // without a fallback its params must be empty (the kernel refuses them)
+                  edit((cur) => ({
+                    ...cur,
+                    fallback: v,
+                    fallbackParams: v === "" ? {} : keepDeclared(declOf(v), cur.fallbackParams),
+                  }));
+                  setFieldErrors((x) => ({ ...x, fallbackParams: {} }));
+                }}
+                options={[{ value: "", label: t("form.fallbackNone") }, ...options]}
+              />
+            </Field>
+          </FormSection>
+          {modelDecl.length > 0 && (
+            <FormSection
+              id="params"
+              title={t("form.modelParamsTitle")}
+              description={t("form.paramsSectionHint")}
+            >
+              <ModelParams
+                parameters={modelDecl}
+                value={d.modelParams}
+                onChange={(modelParams) => edit((cur) => ({ ...cur, modelParams }))}
+                locale={locale}
+                errors={fieldErrors.modelParams}
+              />
+            </FormSection>
+          )}
+          {fallbackDecl.length > 0 && (
+            <FormSection
+              id="fallback-params"
+              title={t("form.fallbackParamsTitle")}
+              description={t("form.paramsSectionHint")}
+            >
+              <ModelParams
+                parameters={fallbackDecl}
+                value={d.fallbackParams}
+                onChange={(fallbackParams) => edit((cur) => ({ ...cur, fallbackParams }))}
+                locale={locale}
+                errors={fieldErrors.fallbackParams}
+              />
+            </FormSection>
+          )}
+        </div>
+      </Stack>
+    </AgentSectionFrame>
+  );
+}
diff --git a/apps/web/src/components/agent/PromptSection.tsx b/apps/web/src/components/agent/PromptSection.tsx
new file mode 100644
index 00000000..694e7bc7
--- /dev/null
+++ b/apps/web/src/components/agent/PromptSection.tsx
@@ -0,0 +1,231 @@
+"use client";
+
+import {
+  Button,
+  Card,
+  Field,
+  Grid,
+  Input,
+  Repeater,
+  Stack,
+  Text,
+  Textarea,
+} from "@capybara-hq/design";
+import { useTranslations } from "next-intl";
+import { useRef, useState } from "react";
+import type { Agent } from "../../lib/agents";
+import {
+  fileNameProblems,
+  INSTRUCTION_FILE_LIMITS,
+  type InstructionFile,
+  joinInstructionFiles,
+  newFileName,
+  readInstructionFiles,
+} from "../../lib/instruction-files";
+import { sameJson, savedDefinition } from "./definition-parts";
+import { SaveFeedback, useDefinitionSave, useSectionActionRow } from "./definition-save";
+import { AgentSectionFrame, useAgentPage } from "./frame";
+import { useSectionDraft } from "./useSectionDraft";
+
+type Entry = InstructionFile & { key: string };
+type Draft = { files: Entry[] };
+
+const draftOf = (a: Agent): Draft => ({
+  files: readInstructionFiles(a.definition).map((f, i) => ({ key: `saved-${i}`, ...f })),
+});
+/** What a draft saves: the files in order, without their keys. */
+const filesOf = (d: Draft): InstructionFile[] =>
+  d.files.map(({ name, content }) => ({ name, content }));
+
+/**
+ * 提示词 Prompt (agent profile design §3.3): the agent's named `.md` files, the list on the left
+ * (add, delete but never the last one, reorder) and the open file's name and content on the
+ * right, with the joined character count against 100 000 and the file count against 20. An agent
+ * saved without files (every old version) shows one `AGENTS.md` holding its instructions. Save
+ * sends `instructionFiles` and no `instructions` (the kernel derives it; a stale one next to the
+ * files would be refused). The names and limits are checked here only as hints: the kernel judges.
+ */
+export function PromptSection() {
+  const t = useTranslations("agents.page.prompt");
+  const { agent } = useAgentPage();
+  const save = useDefinitionSave();
+  const actionRow = useSectionActionRow();
+  const saved = draftOf(agent);
+  const draft = useSectionDraft(saved);
+  const [open, setOpen] = useState<string | null>(null);
+  const [checked, setChecked] = useState(false);
+  const next = useRef(0);
+  const files = draft.draft.files;
+  const current = files.find((f) => f.key === open) ?? files[0];
+  const index = current ? files.indexOf(current) : -1;
+  const edit = (fn: (d: Draft) => Draft) => {
+    save.begin();
+    draft.set(fn);
+  };
+
+  const problems = fileNameProblems(files);
+  const joined = joinInstructionFiles(files).length;
+  const tooLong = joined > INSTRUCTION_FILE_LIMITS.joinedChars;
+  // a name problem shows once the name is edited away from the saved one, or after a save attempt
+  const nameProblem = (i: number) => {
+    const p = problems[i] ?? null;
+    if (p === null) return null;
+    const f = files[i];
+    return checked || saved.files.every((s) => s.name !== f?.name) ? p : null;
+  };
+  const invalidCount = problems.filter((_, i) => nameProblem(i) !== null).length;
+  const unsaved = draft.dirty && !sameJson(filesOf(draft.draft), filesOf(saved)) ? 1 : 0;
+
+  async function onSave() {
+    if (save.pending) return;
+    setChecked(true);
+    if (problems.some((p) => p !== null) || tooLong) return;
+    const { instructions: _derived, ...rest } = savedDefinition(agent);
+    const r = await save.send({ ...rest, instructionFiles: filesOf(draft.draft) });
+    if (r.saved) {
+      draft.reset();
+      setChecked(false);
+      // the saved files are keyed by position: keep the open one open
+      setOpen(`saved-${Math.max(index, 0)}`);
+    }
+  }
+
+  function discard() {
+    draft.reset();
+    save.clear();
+    setChecked(false);
+  }
+
+  const problem = index < 0 ? null : nameProblem(index);
+  return (
+    <AgentSectionFrame
+      dirty={unsaved > 0}
+      actionRow={actionRow({
+        unsaved,
+        errors: invalidCount + (checked && tooLong ? 1 : 0) + (save.error ? 1 : 0),
+        pending: save.pending,
+        onDiscard: discard,
+        onSave: () => void onSave(),
+      })}
+    >
+      <Stack gap={16}>
+        <SaveFeedback save={save} onReload={() => void save.reload(discard)} />
+        <Text variant="small" tone="muted">
+          {t("hint")}
+        </Text>
+        <Grid columns="form">
+          <Stack gap={8}>
+            <Repeater
+              variant="rows"
+              label={t("filesLabel")}
+              addLabel={t("add")}
+              min={1}
+              max={INSTRUCTION_FILE_LIMITS.count}
+              disabled={save.pending}
+              items={files.map((f, i) => ({
+                key: f.key,
+                title: f.name,
+                invalid: nameProblem(i) !== null,
+                body: (
+                  <Button
+                    variant="ghost"
+                    density="dense"
+                    aria-pressed={f.key === current?.key}
+                    onClick={() => setOpen(f.key)}
+                  >
+                    {f.name}
+                  </Button>
+                ),
+              }))}
+              onAdd={() => {
+                next.current += 1;
+                const key = `new-${next.current}`;
+                edit((d) =>
+                  d.files.length >= INSTRUCTION_FILE_LIMITS.count
+                    ? d
+                    : { files: [...d.files, { key, name: newFileName(d.files), content: "" }] },
+                );
+                setOpen(key);
+              }}
+              onRemove={(key) => {
+                const before = files;
+                edit((d) =>
+                  d.files.length <= 1 ? d : { files: d.files.filter((f) => f.key !== key) },
+                );
+                return () => edit(() => ({ files: before }));
+              }}
+              onMove={(key, to) =>
+                edit((d) => {
+                  const from = d.files.findIndex((f) => f.key === key);
+                  if (from < 0) return d;
+                  const list = [...d.files];
+                  const [moved] = list.splice(from, 1);
+                  if (moved) list.splice(to, 0, moved);
+                  return { files: list };
+                })
+              }
+            />
+            <Text variant="small" tone={tooLong ? "fail" : "muted"}>
+              {t("count", {
+                chars: joined,
+                maxChars: INSTRUCTION_FILE_LIMITS.joinedChars,
+                files: files.length,
+                maxFiles: INSTRUCTION_FILE_LIMITS.count,
+              })}
+            </Text>
+            {checked && tooLong ? (
+              <Text variant="small" tone="fail">
+                {t("tooLong", { max: INSTRUCTION_FILE_LIMITS.joinedChars })}
+              </Text>
+            ) : null}
+          </Stack>
+          {current ? (
+            <Card title={current.name}>
+              <Stack gap={12}>
+                <Field
+                  label={t("nameLabel")}
+                  required
+                  help={t("nameHelp")}
+                  {...(problem === "duplicate"
+                    ? { error: t("nameDuplicate") }
+                    : problem === "invalid"
+                      ? { error: t("nameInvalid") }
+                      : {})}
+                >
+                  <Input
+                    name="file-name"
+                    disabled={save.pending}
+                    maxLength={67}
+                    value={current.name}
+                    onChange={(e) => {
+                      const name = e.target.value;
+                      edit((d) => ({
+                        files: d.files.map((f) => (f.key === current.key ? { ...f, name } : f)),
+                      }));
+                    }}
+                  />
+                </Field>
+                <Field label={t("contentLabel")} help={t("contentHelp")}>
+                  <Textarea
+                    code
+                    name="file-content"
+                    disabled={save.pending}
+                    rows={16}
+                    maxLength={INSTRUCTION_FILE_LIMITS.joinedChars}
+                    value={current.content}
+                    onChange={(e) => {
+                      const content = e.target.value;
+                      edit((d) => ({
+                        files: d.files.map((f) => (f.key === current.key ? { ...f, content } : f)),
+                      }));
+                    }}
+                  />
+                </Field>
+              </Stack>
+            </Card>
+          ) : null}
+        </Grid>
+      </Stack>
+    </AgentSectionFrame>
+  );
+}
diff --git a/apps/web/src/components/agent/SkillsSection.tsx b/apps/web/src/components/agent/SkillsSection.tsx
new file mode 100644
index 00000000..b52a28b1
--- /dev/null
+++ b/apps/web/src/components/agent/SkillsSection.tsx
@@ -0,0 +1,182 @@
+"use client";
+
+import { FormSection, Stack } from "@capybara-hq/design";
+import { useTranslations } from "next-intl";
+import { useState } from "react";
+import type { Agent, AgentDefinitionInput } from "../../lib/agents";
+import { PINNED_SKILLS_LIMITS, pinnedProblemsOf, type SkillSummary } from "../../lib/skills";
+import { OrgSkillsPicker, OwnSkills, PinnedSkillsPicker, SkillWriteSwitch } from "../AgentSkills";
+import { useSession } from "../shell/session";
+import { sameJson, savedDefinition } from "./definition-parts";
+import {
+  SaveFeedback,
+  useDefinitionSave,
+  useSectionActionRow,
+  WithFormData,
+} from "./definition-save";
+import type { AgentFormData } from "./form-data";
+import { AgentSectionFrame, useAgentPage } from "./frame";
+import { useSectionDraft } from "./useSectionDraft";
+
+type Draft = { orgSkills: string[]; pinned: string[]; confirmSkillWrite: boolean };
+const draftOf = (a: Agent): Draft => ({
+  orgSkills: [...(a.definition.skills?.orgSkills ?? [])],
+  pinned: [...(a.definition.skills?.pinned ?? [])],
+  confirmSkillWrite: a.definition.skills?.writePolicy === "ask",
+});
+
+/**
+ * 技能 Skills (agent profile design §3.2): the org skills, the pinned ones, the `skill_write`
+ * confirmation and the agent's own skills. The confirmation (`skills.writePolicy`) applies only
+ * to private agents, so it shows when the **saved** visibility is private (Basics' draft never
+ * counts). Its save sends the saved definition with only `skills` changed, merged: keys the web
+ * does not know stay as saved.
+ */
+export function SkillsSection() {
+  return <WithFormData>{(data) => <SkillsEdit data={data} />}</WithFormData>;
+}
+
+function SkillsEdit({ data }: { data: AgentFormData }) {
+  const t = useTranslations("agents");
+  const { me } = useSession();
+  const { orgId, agent } = useAgentPage();
+  const save = useDefinitionSave();
+  const actionRow = useSectionActionRow();
+  const saved = draftOf(agent);
+  const draft = useSectionDraft(saved);
+  const d = draft.draft;
+  const [pinErrors, setPinErrors] = useState<string[]>([]);
+  const orgList = { skills: data.orgSkills ?? [], failed: data.orgSkills === null };
+  const own = { skills: data.ownSkills ?? [], failed: data.ownSkills === null };
+  const allSkills: SkillSummary[] = [...orgList.skills, ...own.skills];
+  /** What the pinned picker may judge (stale pins): both lists read, undefined otherwise. */
+  const pinnable = orgList.failed || own.failed ? undefined : allSkills;
+  const nameOfSkill = (id: string) => allSkills.find((s) => s.id === id)?.name ?? id;
+  const isPrivate = agent.visibility === "private";
+  const edit = (fn: (cur: Draft) => Draft) => {
+    save.begin();
+    draft.set(fn);
+  };
+
+  /**
+   * Selecting org skills: a newly selected skill its plugin suggests pinning is ticked as pinned
+   * while there is room; a deselected one is unpinned.
+   */
+  function onOrgSkillsChange(next: string[]) {
+    edit((cur) => {
+      const added = next.filter((id) => !cur.orgSkills.includes(id));
+      const removed = cur.orgSkills.filter((id) => !next.includes(id));
+      const pinned = cur.pinned.filter((id) => !removed.includes(id));
+      for (const id of added) {
+        const s = orgList.skills.find((x) => x.id === id);
+        if (
+          s?.suggestPinned === true &&
+          !pinned.includes(id) &&
+          pinned.length < PINNED_SKILLS_LIMITS.count
+        )
+          pinned.push(id);
+      }
+      return { ...cur, orgSkills: next, pinned };
+    });
+  }
+
+  const unsaved = [
+    !sameJson(d.orgSkills, saved.orgSkills),
+    !sameJson(d.pinned, saved.pinned),
+    // the switch shows only on private agents: a hidden change does not count
+    isPrivate && d.confirmSkillWrite !== saved.confirmSkillWrite,
+  ].filter(Boolean).length;
+
+  async function onSave() {
+    if (save.pending) return;
+    const definition: Omit<AgentDefinitionInput, "instructionFiles"> = savedDefinition(agent);
+    const before = agent.definition.skills;
+    // a definition without skills stays without (no new version); one that had them is saved as
+    // it is now (emptied too), merged so unknown keys stay
+    if (d.orgSkills.length > 0 || d.confirmSkillWrite || d.pinned.length > 0 || before) {
+      const skills = { ...(before ?? {}), orgSkills: d.orgSkills };
+      // pinned has no default: written only when something is pinned or it was set before
+      if (d.pinned.length > 0 || before?.pinned !== undefined) skills.pinned = d.pinned;
+      // writePolicy: written only when the switch changed; off = the key removed (allow)
+      if (d.confirmSkillWrite !== saved.confirmSkillWrite) {
+        if (d.confirmSkillWrite) skills.writePolicy = "ask";
+        else delete skills.writePolicy;
+      }
+      definition.skills = skills;
+    }
+    setPinErrors([]);
+    const r = await save.send(definition);
+    if (r.saved) {
+      draft.reset();
+      return;
+    }
+    setPinErrors(
+      pinnedProblemsOf(r.error).map((p) =>
+        t(`form.pinnedError.${p.reason}`, {
+          name: nameOfSkill(p.skill),
+          max:
+            p.reason === "too_large" ? PINNED_SKILLS_LIMITS.totalBytes : PINNED_SKILLS_LIMITS.count,
+          bytes: p.totalBytes ?? 0,
+        }),
+      ),
+    );
+  }
+
+  function discard() {
+    draft.reset();
+    save.clear();
+    setPinErrors([]);
+  }
+
+  return (
+    <AgentSectionFrame
+      dirty={draft.dirty}
+      actionRow={actionRow({
+        unsaved,
+        errors: pinErrors.length + (save.error ? 1 : 0),
+        pending: save.pending,
+        onDiscard: discard,
+        onSave: () => void onSave(),
+      })}
+    >
+      <Stack gap={16}>
+        <SaveFeedback save={save} onReload={() => void save.reload(discard)} extra={pinErrors} />
+        <FormSection
+          id="skills"
+          title={t("form.skillsSection")}
+          description={t("form.skillsSectionHint")}
+        >
+          <OrgSkillsPicker
+            skills={orgList.skills}
+            value={d.orgSkills}
+            onChange={onOrgSkillsChange}
+          />
+          <PinnedSkillsPicker
+            skills={pinnable}
+            selected={[...d.orgSkills, ...own.skills.map((s) => s.id)]}
+            value={d.pinned}
+            onChange={(pinned) => edit((cur) => ({ ...cur, pinned }))}
+            changed={!sameJson(d.pinned, saved.pinned)}
+          />
+          {isPrivate && (
+            <SkillWriteSwitch
+              value={d.confirmSkillWrite}
+              onChange={(confirmSkillWrite) => edit((cur) => ({ ...cur, confirmSkillWrite }))}
+            />
+          )}
+          <OwnSkills
+            orgId={orgId}
+            agentId={agent.id}
+            skills={own.skills}
+            canDelete={agent.ownerAccountId === me.account.id}
+            onDeleted={(id) => {
+              if (d.pinned.includes(id)) {
+                edit((cur) => ({ ...cur, pinned: cur.pinned.filter((x) => x !== id) }));
+              }
+            }}
+          />
+        </FormSection>
+      </Stack>
+    </AgentSectionFrame>
+  );
+}
diff --git a/apps/web/src/components/agent/SubagentsSection.tsx b/apps/web/src/components/agent/SubagentsSection.tsx
new file mode 100644
index 00000000..ec3fd6d8
--- /dev/null
+++ b/apps/web/src/components/agent/SubagentsSection.tsx
@@ -0,0 +1,73 @@
+"use client";
+
+import { Stack } from "@capybara-hq/design";
+import type { AgentToolRef } from "../../lib/agents";
+import { AGENT_TOOL, useSubagentsForm } from "../AgentSubagents";
+import { replaceToolRefs, savedDefinition } from "./definition-parts";
+import {
+  SaveFeedback,
+  useDefinitionSave,
+  useSectionActionRow,
+  WithFormData,
+} from "./definition-save";
+import type { AgentFormData } from "./form-data";
+import { AgentSectionFrame, useAgentPage } from "./frame";
+
+const isAgentTool = (r: AgentToolRef) => r.kind === "builtin" && r.name === AGENT_TOOL;
+
+/**
+ * 子 Agent Sub-agents (agent profile design §3.2): the `agent` tool and the `subagents` block.
+ * The rules that depend on who can see the agent (the "shared more widely" warning) read the
+ * **saved** visibility. Its save sends the saved definition with only the `agent` tool reference
+ * and `subagents` changed (no block when there is nothing and there was nothing).
+ */
+export function SubagentsSection() {
+  return <WithFormData>{(data) => <SubagentsEdit data={data} />}</WithFormData>;
+}
+
+function SubagentsEdit({ data }: { data: AgentFormData }) {
+  const { agent } = useAgentPage();
+  const save = useDefinitionSave();
+  const actionRow = useSectionActionRow();
+  const form = useSubagentsForm(agent, agent.visibility, data.subagents, save.begin);
+
+  async function onSave() {
+    if (save.pending) return;
+    const { subagents: _old, ...rest } = savedDefinition(agent);
+    form.showProblems(undefined);
+    const r = await save.send({
+      ...rest,
+      tools: replaceToolRefs(
+        agent.definition.tools ?? [],
+        isAgentTool,
+        form.agentTool ? [{ kind: "builtin", name: AGENT_TOOL }] : [],
+      ),
+      ...(form.value !== undefined ? { subagents: form.value } : {}),
+    });
+    if (r.saved) form.reset();
+    else form.showProblems(r.error);
+  }
+
+  function discard() {
+    form.reset();
+    save.clear();
+  }
+
+  return (
+    <AgentSectionFrame
+      dirty={form.dirty}
+      actionRow={actionRow({
+        unsaved: form.unsaved,
+        errors: form.errors + (save.error ? 1 : 0),
+        pending: save.pending,
+        onDiscard: discard,
+        onSave: () => void onSave(),
+      })}
+    >
+      <Stack gap={16}>
+        <SaveFeedback save={save} onReload={() => void save.reload(discard)} />
+        {form.section}
+      </Stack>
+    </AgentSectionFrame>
+  );
+}
diff --git a/apps/web/src/components/agent/ToolsSection.tsx b/apps/web/src/components/agent/ToolsSection.tsx
new file mode 100644
index 00000000..78d7a074
--- /dev/null
+++ b/apps/web/src/components/agent/ToolsSection.tsx
@@ -0,0 +1,242 @@
+"use client";
+
+import { Checkbox, Field, FormSection, Select, Stack, Text } from "@capybara-hq/design";
+import { useQueries } from "@tanstack/react-query";
+import { useTranslations } from "next-intl";
+import { useState } from "react";
+import {
+  type Agent,
+  type AgentToolRef,
+  BUILTIN_TOOLS,
+  type TightenedPolicy,
+} from "../../lib/agents";
+import type { ConnectorDetail } from "../../lib/connectors";
+import { retryOnMountOf } from "../../lib/query/client";
+import { connectorQuery } from "../../lib/query/conversation";
+import { BUILTIN_SET, replaceToolRefs, sameJson, savedDefinition } from "./definition-parts";
+import {
+  SaveFeedback,
+  useDefinitionSave,
+  useSectionActionRow,
+  WithFormData,
+} from "./definition-save";
+import type { AgentFormData } from "./form-data";
+import { AgentSectionFrame, useAgentPage } from "./frame";
+import { useSectionDraft } from "./useSectionDraft";
+
+/** The references this section switches: the listed builtins and whole connectors. */
+const isSectionTool = (r: AgentToolRef) =>
+  (r.kind === "builtin" && BUILTIN_SET.has(r.name)) ||
+  (r.kind === "connector" && r.tools === "all");
+
+type Draft = {
+  builtins: string[];
+  connectors: string[];
+  policies: Record<string, TightenedPolicy>;
+};
+const draftOf = (a: Agent): Draft => {
+  const tools = a.definition.tools ?? [];
+  return {
+    builtins: tools.flatMap((r) =>
+      r.kind === "builtin" && BUILTIN_SET.has(r.name) ? [r.name] : [],
+    ),
+    connectors: tools.flatMap((r) =>
+      r.kind === "connector" && r.tools === "all" ? [r.connectorId] : [],
+    ),
+    policies: { ...(a.definition.toolPolicies ?? {}) },
+  };
+};
+const sorted = (xs: string[]) => [...xs].sort();
+
+/**
+ * 工具 Tools (agent profile design §3.2): the builtin tools, the active connectors (all their
+ * enabled tools) and a tightened policy per referenced tool. Its save sends the saved definition
+ * with only `tools` and `toolPolicies` changed: references it does not switch (plugin tools,
+ * connectors picked by name, the `agent` tool of Sub-agents) and their policies stay as saved.
+ */
+export function ToolsSection() {
+  return <WithFormData>{(data) => <ToolsEdit data={data} />}</WithFormData>;
+}
+
+function ToolsEdit({ data }: { data: AgentFormData }) {
+  const t = useTranslations("agents");
+  const { orgId, agent } = useAgentPage();
+  const save = useDefinitionSave();
+  const actionRow = useSectionActionRow();
+  const saved = draftOf(agent);
+  const draft = useSectionDraft(saved);
+  const d = draft.draft;
+  // the connectors on offer: the active ones (none when the list could not be read)
+  const apps = (data.connectors ?? []).filter((a) => a.status === "active");
+  // every connector selected since the section opened: their tools are read (cached), so one
+  // switched off again still counts as managed when its policies are dropped on save
+  const [seen, setSeen] = useState<string[]>(saved.connectors);
+  const seenIds = [...new Set([...seen, ...d.connectors])];
+  const details = useQueries({
+    queries: seenIds.map((id) => {
+      const q = connectorQuery(orgId, id);
+      return { ...q, retryOnMount: retryOnMountOf(q.queryKey) };
+    }),
+  });
+  const connectorDetails: Record<string, ConnectorDetail> = Object.fromEntries(
+    seenIds.flatMap((id, i) => {
+      const x = details[i]?.data;
+      return x === undefined ? [] : [[id, x]];
+    }),
+  );
+  const edit = (fn: (cur: Draft) => Draft) => {
+    save.begin();
+    draft.set(fn);
+  };
+
+  /** The referenced tool keys (for tightening): the builtins and the selected connectors' tools. */
+  const toolKeys = [
+    ...d.builtins,
+    ...d.connectors.flatMap((id) =>
+      (connectorDetails[id]?.tools ?? []).filter((x) => x.status === "enabled").map((x) => x.key),
+    ),
+  ];
+
+  const unsaved = [
+    !sameJson(sorted(d.builtins), sorted(saved.builtins)),
+    !sameJson(sorted(d.connectors), sorted(saved.connectors)),
+    !sameJson(d.policies, saved.policies),
+  ].filter(Boolean).length;
+
+  async function onSave() {
+    if (save.pending) return;
+    const picked: AgentToolRef[] = [
+      ...d.builtins.map((name) => ({ kind: "builtin" as const, name })),
+      ...d.connectors.map((connectorId) => ({
+        kind: "connector" as const,
+        connectorId,
+        tools: "all" as const,
+      })),
+    ];
+    // a policy of a tool this section manages goes with it; the others stay as saved
+    const managed = (k: string) =>
+      BUILTIN_SET.has(k) ||
+      Object.values(connectorDetails).some((a) => a.tools.some((x) => x.key === k));
+    const r = await save.send({
+      ...savedDefinition(agent),
+      tools: replaceToolRefs(agent.definition.tools ?? [], isSectionTool, picked),
+      toolPolicies: Object.fromEntries(
+        Object.entries(d.policies).filter(([k]) => toolKeys.includes(k) || !managed(k)),
+      ),
+    });
+    if (r.saved) draft.reset();
+  }
+
+  function discard() {
+    draft.reset();
+    save.clear();
+  }
+
+  return (
+    <AgentSectionFrame
+      dirty={draft.dirty}
+      actionRow={actionRow({
+        unsaved,
+        errors: save.error ? 1 : 0,
+        pending: save.pending,
+        onDiscard: discard,
+        onSave: () => void onSave(),
+      })}
+    >
+      <Stack gap={16}>
+        <SaveFeedback save={save} onReload={() => void save.reload(discard)} />
+        <FormSection
+          id="tools"
+          title={t("form.toolsSection")}
+          description={t("form.toolsSectionHint")}
+        >
+          {/* biome-ignore lint/a11y/useSemanticElements: fieldset 带浏览器默认边框与内边距，apps/web 不能写样式；用 role=group 分组 */}
+          <div role="group" aria-label={t("form.builtinLabel")}>
+            <Stack gap={4}>
+              <Text variant="small" tone="muted">
+                {t("form.builtinLabel")}
+              </Text>
+              {BUILTIN_TOOLS.map((name) => (
+                <Checkbox
+                  key={name}
+                  label={t(`form.builtin.${name}`)}
+                  checked={d.builtins.includes(name)}
+                  disabled={save.pending}
+                  onChange={(on) =>
+                    edit((cur) => ({
+                      ...cur,
+                      builtins: on
+                        ? [...cur.builtins, name]
+                        : cur.builtins.filter((x) => x !== name),
+                    }))
+                  }
+                />
+              ))}
+            </Stack>
+          </div>
+          {/* biome-ignore lint/a11y/useSemanticElements: fieldset 带浏览器默认边框与内边距，apps/web 不能写样式；用 role=group 分组 */}
+          <div role="group" aria-label={t("form.connectorsLabel")}>
+            <Stack gap={4}>
+              <Text variant="small" tone="muted">
+                {t("form.connectorsLabel")}
+              </Text>
+              {apps.length === 0 && (
+                <Text variant="small" tone="faint">
+                  {t("form.noConnectors")}
+                </Text>
+              )}
+              {apps.map((a) => (
+                <Checkbox
+                  key={a.id}
+                  label={t("form.connectorTools", { name: a.name })}
+                  checked={d.connectors.includes(a.id)}
+                  disabled={save.pending}
+                  onChange={(on) => {
+                    if (on) setSeen((cur) => (cur.includes(a.id) ? cur : [...cur, a.id]));
+                    edit((cur) => ({
+                      ...cur,
+                      connectors: on
+                        ? [...cur.connectors, a.id]
+                        : cur.connectors.filter((id) => id !== a.id),
+                    }));
+                  }}
+                />
+              ))}
+            </Stack>
+          </div>
+          {toolKeys.length > 0 && (
+            <Stack gap={4}>
+              <Text variant="small" tone="muted">
+                {t("form.policiesLabel")}
+              </Text>
+              {toolKeys.map((key) => (
+                <div key={key} data-policy={key}>
+                  <Field label={key}>
+                    <Select
+                      value={d.policies[key] ?? ""}
+                      disabled={save.pending}
+                      onChange={(e) => {
+                        const v = e.target.value as TightenedPolicy | "";
+                        edit((cur) => {
+                          const policies = { ...cur.policies };
+                          if (v === "") delete policies[key];
+                          else policies[key] = v;
+                          return { ...cur, policies };
+                        });
+                      }}
+                      options={[
+                        { value: "", label: t("form.policy.default") },
+                        { value: "ask", label: t("form.policy.ask") },
+                        { value: "deny", label: t("form.policy.deny") },
+                      ]}
+                    />
+                  </Field>
+                </div>
+              ))}
+            </Stack>
+          )}
+        </FormSection>
+      </Stack>
+    </AgentSectionFrame>
+  );
+}
diff --git a/apps/web/src/components/agent/definition-parts.ts b/apps/web/src/components/agent/definition-parts.ts
new file mode 100644
index 00000000..8a169dcd
--- /dev/null
+++ b/apps/web/src/components/agent/definition-parts.ts
@@ -0,0 +1,58 @@
+import {
+  type Agent,
+  type AgentDefinitionInput,
+  type AgentToolRef,
+  BUILTIN_TOOLS,
+} from "../../lib/agents";
+import type { ModelRef } from "../../lib/conversations";
+
+/** The builtin tools the Tools section switches. */
+export const BUILTIN_SET = new Set<string>(BUILTIN_TOOLS);
+
+/**
+ * The saved definition a section's save starts from: every field as saved, without the prompt
+ * files and the retired `avatarUrl`. The kernel keeps the prompt files while `instructions` is
+ * their join (it is, as saved), and the profile owns avatars.
+ */
+export function savedDefinition(agent: Agent): Omit<AgentDefinitionInput, "instructionFiles"> {
+  const {
+    instructionFiles: _files,
+    avatarUrl: _avatarUrl,
+    ...kept
+  }: Record<string, unknown> = agent.definition;
+  return kept as unknown as Omit<AgentDefinitionInput, "instructionFiles">;
+}
+
+/** A model select's value: `provider/model` (provider names have no `/`; model ids may). */
+export const encodeModel = (r: ModelRef) => `${r.provider}/${r.model}`;
+export function decodeModel(v: string): ModelRef | null {
+  const i = v.indexOf("/");
+  return i <= 0 ? null : { provider: v.slice(0, i), model: v.slice(i + 1) };
+}
+
+/** A tool reference's identity, whatever its key order. */
+const refKey = (r: AgentToolRef) =>
+  r.kind === "builtin"
+    ? `builtin:${r.name}`
+    : r.kind === "connector"
+      ? `app:${r.connectorId}:${r.tools === "all" ? "*" : r.tools.join(",")}`
+      : `plugin:${r.plugin}:${r.name}`;
+
+/**
+ * The saved tool references with the ones a section manages (`managed`) replaced by `picked`:
+ * the saved order is kept for those still picked, new ones go last, and everything the section
+ * does not manage stays as it is. An unchanged pick gives back the saved list exactly, so it makes
+ * no new version.
+ */
+export function replaceToolRefs(
+  saved: readonly AgentToolRef[],
+  managed: (r: AgentToolRef) => boolean,
+  picked: readonly AgentToolRef[],
+): AgentToolRef[] {
+  const pickedKeys = new Set(picked.map(refKey));
+  const kept = saved.filter((r) => !managed(r) || pickedKeys.has(refKey(r)));
+  const keptKeys = new Set(kept.map(refKey));
+  return [...kept, ...picked.filter((r) => !keptKeys.has(refKey(r)))];
+}
+
+export const sameJson = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
diff --git a/apps/web/src/components/agent/definition-save.tsx b/apps/web/src/components/agent/definition-save.tsx
new file mode 100644
index 00000000..cd270e25
--- /dev/null
+++ b/apps/web/src/components/agent/definition-save.tsx
@@ -0,0 +1,177 @@
+"use client";
+
+import { type ActionRowProps, Callout, Card, Stack, Text } from "@capybara-hq/design";
+import { useQueryClient } from "@tanstack/react-query";
+import { useTranslations } from "next-intl";
+import { type ReactNode, useState } from "react";
+import { type AgentDefinitionSave, type AgentWarning, updateAgent } from "../../lib/agents";
+import { ApiClientError } from "../../lib/api";
+import { keys } from "../../lib/query/keys";
+import { useAppMutation } from "../../lib/query/mutation";
+import { useErrorMessage } from "../../lib/use-error-message";
+import { ErrorFrame } from "../ErrorFrame";
+import { FormError } from "../form-error";
+import { CONFLICT_CODES } from "./BasicsSection";
+import { type AgentFormData, useAgentFormData } from "./form-data";
+import { AgentSectionFrame, useAgentPage } from "./frame";
+
+export type SaveResult = { saved: true } | { saved: false; error: unknown };
+
+/** What {@link useDefinitionSave} gives a definition section. */
+export interface DefinitionSave {
+  pending: boolean;
+  /** The last save's failure (null after a success, a discard or a reload). */
+  error: unknown;
+  /** The kernel's warnings after the last save. */
+  warnings: AgentWarning[];
+  /** Call on each edit: the first one takes the version the edit is made on. */
+  begin(): void;
+  /** Sends the definition with `expectedVersion`: saved, or the failure. */
+  send(definition: AgentDefinitionSave): Promise<SaveResult>;
+  /** Forgets the version and the error (after a discard). */
+  clear(): void;
+  /** Reads the agent again, then calls `after` (the section starts over from the newer version). */
+  reload(after: () => void): Promise<void>;
+}
+
+/**
+ * One definition section's save (agent profile design §3.2): `PATCH …/agents/:id` with the
+ * section's definition and the version its first edit was made on, so a save over someone
+ * else's newer version is a 409 with a reload, never a silent overwrite. A save invalidates the
+ * agents list and the agent; it resolves once the agent was read again.
+ */
+export function useDefinitionSave(): DefinitionSave {
+  const qc = useQueryClient();
+  const { orgId, agent } = useAgentPage();
+  const [base, setBase] = useState<number | null>(null);
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<unknown>(null);
+  const [warnings, setWarnings] = useState<AgentWarning[]>([]);
+  const mutation = useAppMutation({
+    fn: (input: { definition: AgentDefinitionSave; expectedVersion: number }) =>
+      updateAgent(orgId, agent.id, input),
+    invalidates: () => [keys.org(orgId).agents(), keys.org(orgId).agent(agent.id)],
+  });
+  const clear = () => {
+    setBase(null);
+    setError(null);
+  };
+  return {
+    pending,
+    error,
+    warnings,
+    begin: () => setBase((b) => b ?? agent.currentVersion),
+    async send(definition) {
+      setPending(true);
+      setError(null);
+      setWarnings([]);
+      try {
+        const r = await mutation.mutateAsync({
+          definition,
+          expectedVersion: base ?? agent.currentVersion,
+        });
+        setBase(null);
+        setWarnings(r.warnings);
+        return { saved: true };
+      } catch (e) {
+        setError(e);
+        return { saved: false, error: e };
+      } finally {
+        setPending(false);
+      }
+    },
+    clear,
+    async reload(after) {
+      await qc.refetchQueries({ queryKey: keys.org(orgId).agent(agent.id) });
+      clear();
+      setWarnings([]);
+      after();
+    },
+  };
+}
+
+/**
+ * Above a definition section's fields: the kernel's warnings after a save (a danger card), and a
+ * failed save's error (a conflict offers the reload; `extra` lists lines no field shows).
+ */
+export function SaveFeedback({
+  save,
+  onReload,
+  extra = [],
+}: {
+  save: DefinitionSave;
+  onReload(): void;
+  extra?: string[];
+}) {
+  const t = useTranslations("agents");
+  const errorMessage = useErrorMessage();
+  const { error, warnings } = save;
+  return (
+    <>
+      {warnings.length > 0 && (
+        <Card tone="danger" title={t("form.warningsTitle")}>
+          <Stack gap={4}>
+            {warnings.map((w) => (
+              <Text key={w} tone="warn" icon="circle-alert">
+                {t.has(`warnings.${w}`) ? t(`warnings.${w}`) : t("warnings.unknown", { code: w })}
+              </Text>
+            ))}
+          </Stack>
+        </Card>
+      )}
+      {error === null ? null : error instanceof ApiClientError && CONFLICT_CODES.has(error.code) ? (
+        <Callout tone="fail" action={{ label: t("page.reload"), onSelect: onReload }}>
+          {errorMessage(error)}
+        </Callout>
+      ) : (
+        <FormError message={errorMessage(error)} extra={extra} />
+      )}
+    </>
+  );
+}
+
+/** The options of {@link useSectionActionRow}'s row. */
+export interface SectionRowOptions {
+  unsaved: number;
+  errors: number;
+  pending: boolean;
+  onDiscard(): void;
+  onSave(): void;
+  /** Save is off for another reason than "nothing changed" (no models to pick). */
+  disabled?: boolean;
+}
+
+/**
+ * A section's action row by the template's rule: only with changes, while saving, or after a
+ * failure; Discard only with changes.
+ */
+export function useSectionActionRow(): (o: SectionRowOptions) => ActionRowProps | undefined {
+  const t = useTranslations("agents");
+  return (o) =>
+    o.unsaved === 0 && !o.pending && o.errors === 0
+      ? undefined
+      : {
+          unsaved: o.unsaved,
+          errors: o.errors,
+          ...(o.unsaved > 0 ? { cancel: { label: t("page.discard"), onSelect: o.onDiscard } } : {}),
+          primary: {
+            label: t("form.submit"),
+            onSelect: o.onSave,
+            loading: o.pending,
+            disabled: o.pending || o.unsaved === 0 || o.disabled === true,
+          },
+        };
+}
+
+/**
+ * A definition section with the agent form's reads (models, connectors, skills, sub-agent
+ * lists): the section's loading frame until they answer, the error frame when a required one
+ * failed, else `children` with the data.
+ */
+export function WithFormData({ children }: { children(data: AgentFormData): ReactNode }) {
+  const { orgId, agent } = useAgentPage();
+  const state = useAgentFormData(orgId, agent.id);
+  if (state.kind === "error") return <ErrorFrame reset={state.retry} />;
+  if (state.kind === "loading") return <AgentSectionFrame loading />;
+  return <>{children(state.data)}</>;
+}
diff --git a/apps/web/src/components/agent/form-data.ts b/apps/web/src/components/agent/form-data.ts
new file mode 100644
index 00000000..00f25e8f
--- /dev/null
+++ b/apps/web/src/components/agent/form-data.ts
@@ -0,0 +1,111 @@
+"use client";
+
+import { type UseQueryResult, useQuery } from "@tanstack/react-query";
+import type { ProviderModels } from "../../lib/agents";
+import type { ApiClientError } from "../../lib/api";
+import type { ConnectorSummary } from "../../lib/connectors";
+import { agentSkillsQuery, agentsQuery, agentTemplatesQuery } from "../../lib/query/agents";
+import { retryOnMountOf } from "../../lib/query/client";
+import { connectorsQuery, modelsQuery } from "../../lib/query/conversation";
+import { membersQuery } from "../../lib/query/members";
+import { skillsQuery } from "../../lib/query/skills";
+import type { SkillSummary } from "../../lib/skills";
+import type { SubagentsFormData } from "../AgentSubagents";
+
+/**
+ * What the agent form shows, from its queries (`agentFormQueries` in `lib/query/agents.ts`). A
+ * `null` list could not be read (the kernel refused or failed it): that part shows its own empty or
+ * unavailable state.
+ */
+export interface AgentFormData {
+  providers: ProviderModels[];
+  connectors: ConnectorSummary[] | null;
+  orgSkills: SkillSummary[] | null;
+  /** The agent's own skills (`[]` for a new agent). */
+  ownSkills: SkillSummary[] | null;
+  subagents: SubagentsFormData;
+}
+
+/** The agent form's data as a page draws it. */
+export type AgentFormState =
+  | { kind: "loading" }
+  | { kind: "ready"; data: AgentFormData }
+  | { kind: "error"; code: string; retry(): void };
+
+/** A read the form needs (the models): any failure fails the page. */
+const REQUIRED = "required";
+/** A read the role decides (connectors, org skills, members): a 403 / 404 leaves the part out. */
+const OPTIONAL = "optional";
+/** A section (templates, org agents, own skills): any failure is that part's own state. */
+const SECTION = "section";
+
+/**
+ * The agent form's reads from the query cache (new agent, or `agentId` to edit), as one state:
+ * `loading` until every read answered, `error` when a required read failed (or an optional one
+ * failed otherwise than 403 / 404), else the data with `null` for the parts that could not be read.
+ * An error the server already read is not read again on mount; `retry` reads the failed ones.
+ */
+export function useAgentFormData(orgId: string, agentId?: string): AgentFormState {
+  const modelsQ = modelsQuery(orgId);
+  const connectorsQ = connectorsQuery(orgId);
+  const skillsQ = skillsQuery(orgId);
+  const templatesQ = agentTemplatesQuery(orgId);
+  const agentsQ = agentsQuery(orgId);
+  const membersQ = membersQuery(orgId);
+  // A query of no agent is disabled; the key's agent id is then never read.
+  const ownQ = agentSkillsQuery(orgId, agentId ?? "");
+  const models = useQuery({ ...modelsQ, retryOnMount: retryOnMountOf(modelsQ.queryKey) });
+  const connectors = useQuery({
+    ...connectorsQ,
+    retryOnMount: retryOnMountOf(connectorsQ.queryKey),
+  });
+  const skills = useQuery({ ...skillsQ, retryOnMount: retryOnMountOf(skillsQ.queryKey) });
+  const templates = useQuery({ ...templatesQ, retryOnMount: retryOnMountOf(templatesQ.queryKey) });
+  const agents = useQuery({ ...agentsQ, retryOnMount: retryOnMountOf(agentsQ.queryKey) });
+  const members = useQuery({ ...membersQ, retryOnMount: retryOnMountOf(membersQ.queryKey) });
+  const own = useQuery({
+    ...ownQ,
+    retryOnMount: retryOnMountOf(ownQ.queryKey),
+    enabled: agentId !== undefined,
+  });
+  const all: [UseQueryResult<unknown, ApiClientError>, string][] = [
+    [models, REQUIRED],
+    [connectors, OPTIONAL],
+    [skills, OPTIONAL],
+    [members, OPTIONAL],
+    [templates, SECTION],
+    [agents, SECTION],
+    ...(agentId === undefined ? [] : ([[own, SECTION]] as [typeof own, string][])),
+  ];
+  if (all.some(([q]) => q.data === undefined && q.error === null)) return { kind: "loading" };
+  const fatal = all.find(
+    ([q, kind]) =>
+      q.data === undefined &&
+      q.error !== null &&
+      (kind === REQUIRED ||
+        (kind === OPTIONAL && q.error.status !== 403 && q.error.status !== 404)),
+  );
+  if (fatal?.[0].error) {
+    return {
+      kind: "error",
+      code: fatal[0].error.code,
+      retry: () => {
+        for (const [q] of all) if (q.error !== null) void q.refetch();
+      },
+    };
+  }
+  return {
+    kind: "ready",
+    data: {
+      providers: models.data?.providers ?? [],
+      connectors: connectors.data?.connectors ?? null,
+      orgSkills: skills.data?.skills ?? null,
+      ownSkills: agentId === undefined ? [] : (own.data?.skills ?? null),
+      subagents: {
+        templates: templates.data?.templates ?? null,
+        agents: agents.data?.agents ?? null,
+        members: members.data?.members ?? null,
+      },
+    },
+  };
+}
