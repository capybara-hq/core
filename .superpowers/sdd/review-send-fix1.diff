 .cb-shell {
+  /* The shell fills the window and scrolls only inside its regions: it is a containing block that
+     clips its overflow, so nothing in it can make the document scrollable (review fix L3). */
+  position: relative;
   display: flex;
   height: 100vh;
   min-height: 0;
+  overflow: clip;
   background: var(--cb-bg);
   color: var(--cb-ink);
 }
 /* Inside a reference block the shell fills the block instead of the window. */
 .cb-ref-block .cb-shell {
   height: 100%;
 }
 .cb-shell-column {
   display: flex;
   flex: 1;
