+    .split("/")
+    .filter((s) => s !== "")
+    .map((s): Seg => {
+      const rest = /^\[\.\.\.(.+)\]$/.exec(s);
+      if (rest?.[1] !== undefined) return { kind: "rest", name: rest[1] };
+      const param = /^\[(.+)\]$/.exec(s);
+      if (param?.[1] !== undefined) return { kind: "param", name: param[1] };
+      return { kind: "static", name: s };
+    });
