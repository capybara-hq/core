diff --git a/docs/design/reference/src/reference.css b/docs/design/reference/src/reference.css
index 6e6083f1..33e3f412 100644
--- a/docs/design/reference/src/reference.css
+++ b/docs/design/reference/src/reference.css
@@ -3609,10 +3609,165 @@ textarea {
 .r-lrow:first-child {
   border-top: 0;
 }
 .r-lrow-text {
   display: flex;
   flex: 1;
