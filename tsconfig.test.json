{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "**/test/**/*.ts",
    "packages/testing/fixtures/**/*.ts",
    "vitest.config.ts",
    "commitlint.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "tools/checks/fixtures", "apps/web", "packages/design"]
}
