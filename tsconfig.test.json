{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "**/test/**/*.ts",
    "packages/testing/fixtures/**/*.ts",
    "tools/dev/export-review-corpus.ts",
    "packages/device/tools/*.ts",
    "vitest.config.ts",
    "commitlint.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "tools/checks/fixtures",
    "packages/plugin-tools/fixtures",
    "apps/web",
    "packages/design"
  ]
}
