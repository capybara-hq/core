# Copy to .env (gitignored) for running from source: `capybara` loads .env from the working
# directory before every command; variables already set in the shell win. --env-file <path> loads
# another file, --no-env-file none. Every config key can be set here as CAPYBARA_<A>__<B>
# (db.url -> CAPYBARA_DB__URL); see docs/config.md.

# Where the rest of the config comes from: file (default) or nacos
# CAPYBARA_CONFIG_SOURCE=file
# CAPYBARA_CONFIG_FILE=./capybara.yaml
# With CAPYBARA_CONFIG_SOURCE=nacos:
# CAPYBARA_NACOS_SERVER=nacos:8848
# CAPYBARA_NACOS_NAMESPACE=
# CAPYBARA_NACOS_DATA_ID=capybara.yaml
# CAPYBARA_NACOS_USERNAME=
# CAPYBARA_NACOS_PASSWORD=

# Required unless the config file / Nacos sets them
CAPYBARA_DB__URL=postgres://capybara:capybara@localhost:5432/capybara
CAPYBARA_REDIS__URL=redis://localhost:6379
# Generate once and keep it: it encrypts stored secrets (openssl rand -base64 32)
CAPYBARA_MASTER_KEY=

# Behind the web app's /api proxy
CAPYBARA_HTTP__TRUST_PROXY=1

# object-store-s3 (the compose.dev.yaml SeaweedFS); the endpoint must be reachable from the browser too
# CAPYBARA_EXTENSION_CONFIG={"object-store-s3":{"endpoint":"http://localhost:8333","region":"us-east-1","bucket":"capybara","accessKeyId":"capybara","secretAccessKey":"capybara-secret","forcePathStyle":true}}
